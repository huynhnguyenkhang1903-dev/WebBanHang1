@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Websitebanhang.Models.StockHistory>

@{
    ViewData["Title"] = "Lịch sử kho hàng";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-primary">
            <i class="fa-solid fa-clock-rotate-left me-2"></i> Lịch Sử Kho Hàng
        </h2>
        <div class="d-flex gap-2">
             <a asp-controller="Product" asp-action="Manage" class="btn btn-outline-secondary">
                <i class="fa-solid fa-boxes-stacked me-1"></i> Quản lý kho
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Sản phẩm</label>
                    <select name="productId" class="form-select select2">
                        <option value="">-- Tất cả sản phẩm --</option>
                        @foreach (var p in (List<Websitebanhang.Models.Product>)ViewBag.Products)
                        {
                            <!option value="@p.Id" @(ViewBag.SelectedProductId == p.Id ? "selected" : "")>@p.Name</!option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Loại thay đổi</label>
                    <select name="type" class="form-select">
                        <option value="">-- Tất cả --</option>
                        <!option value="Nhập kho" @(ViewBag.SelectedType == "Nhập kho" ? "selected" : "")>Nhập kho</!option>
                        <!option value="Xuất kho (Bán hàng)" @(ViewBag.SelectedType == "Xuất kho (Bán hàng)" ? "selected" : "")>Xuất kho (Bán hàng)</!option>
                        <!option value="Nhập thêm" @(ViewBag.SelectedType == "Nhập thêm" ? "selected" : "")>Nhập thêm (Admin)</!option>
                        <!option value="Điều chỉnh giảm" @(ViewBag.SelectedType == "Điều chỉnh giảm" ? "selected" : "")>Điều chỉnh giảm</!option>
                        <!option value="Nhập kho (Hủy đơn)" @(ViewBag.SelectedType == "Nhập kho (Hủy đơn)" ? "selected" : "")>Hoàn tồn (Hủy đơn)</!option>
                        <!option value="Nhập kho (Trả hàng)" @(ViewBag.SelectedType == "Nhập kho (Trả hàng)" ? "selected" : "")>Hoàn tồn (Trả hàng)</!option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-filter me-1"></i> Lọc
                    </button>
                </div>
                <div class="col-md-1">
                    <a asp-action="History" class="btn btn-light w-100" title="Reset">
                        <i class="fa-solid fa-rotate"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Ngày giờ</th>
                            <th>Sản phẩm</th>
                            <th class="text-center">Thay đổi</th>
                            <th class="text-center">Tồn sau</th>
                            <th>Loại</th>
                            <th>Người thực hiện / Ghi chú</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fa-solid fa-inbox fa-3x mb-3 d-block"></i>
                                    Chưa có lịch sử thay đổi nào khớp với bộ lọc.
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 small text-muted">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                        {
                                            <img src="@item.Product.ImageUrl" class="rounded me-2" style="width:35px;height:35px;object-fit:cover;">
                                        }
                                        <span class="fw-medium">@item.Product?.Name</span>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (item.QuantityChange > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fw-bold">
                                            <i class="fa-solid fa-arrow-up me-1"></i>+@item.QuantityChange
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger fw-bold">
                                            <i class="fa-solid fa-arrow-down me-1"></i>@item.QuantityChange
                                        </span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark">@item.BalanceAfter</td>
                                <td>
                                    <span class="small">@item.Type</span>
                                </td>
                                <td>
                                    <div class="small">
                                        @if (item.User != null)
                                        {
                                            <span class="text-primary"><i class="fa-solid fa-user-tie me-1"></i>@item.User.FullName</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted"><i class="fa-solid fa-robot me-1"></i>Hệ thống</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Note))
                                    {
                                        <div class="text-muted x-small mt-1 fst-italic">@item.Note</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.PageCount > 1)
        {
            <div class="card-footer bg-white border-top-0 py-3">
                <div class="d-flex justify-content-center">
                    @Html.PagedListPager(Model, page => Url.Action("History", new { page, productId = ViewBag.SelectedProductId, type = ViewBag.SelectedType }), 
                        new PagedListRenderOptions {
                            LiElementClasses = new string[] { "page-item" },
                            PageClasses = new string[] { "page-link" },
                            UlElementClasses = new string[] { "pagination", "pagination-sm", "mb-0" }
                        })
                </div>
            </div>
        }
    </div>
</div>

<style>
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-danger-subtle { background-color: #f8d7da; }
    .x-small { font-size: 0.75rem; }
</style>
