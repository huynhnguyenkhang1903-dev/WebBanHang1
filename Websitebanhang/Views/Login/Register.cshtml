@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center">

<div class="col-md-6">

<div class="card shadow-lg border-0">

<div class="card-header text-center bg-dark text-white">
<h3><i class="fa fa-user-plus"></i> Register</h3>
</div>

<div class="card-body">

<form method="post">

<div class="mb-3">
<label class="form-label">
<i class="fa fa-user"></i> Full Name
</label>

<input type="text"
       name="fullname"
       class="form-control"
       placeholder="Nhập họ tên"
       required />
</div>

<div class="mb-3">
<label class="form-label">
<i class="fa fa-envelope"></i> Email
</label>

<input type="email"
       name="email"
       class="form-control"
       placeholder="Nhập email"
       required />
</div>

<div class="mb-3">
<label class="form-label">
<i class="fa fa-phone"></i> Phone
</label>

<input type="text"
       name="phone"
       class="form-control"
       placeholder="Nhập số điện thoại"
       required />
</div>

<div class="mb-3">
<label class="form-label">
<i class="fa fa-map-marker-alt"></i> Address
</label>

<input type="text"
       name="address"
       class="form-control"
       placeholder="Nhập địa chỉ"
       required />
</div>

<div class="mb-3">
<label class="form-label">
<i class="fa fa-lock"></i> Password
</label>

<input type="password"
       name="password"
       class="form-control"
       placeholder="Nhập mật khẩu"
       required />
</div>

<div class="mb-3">
<label class="form-label">
<i class="fa fa-lock"></i> Confirm Password
</label>

<input type="password"
       name="confirmpassword"
       class="form-control"
       placeholder="Nhập lại mật khẩu"
       required />
</div>

<div class="d-grid">
<button class="btn btn-dark">
<i class="fa fa-user-plus"></i>
Register
</button>
</div>

</form>

<div class="text-center mt-3">
Đã có tài khoản?
<a asp-controller="Login" asp-action="Login">
Đăng nhập
</a>
</div>

</div>

</div>

</div>

</div>