@model Websitebanhang.Models.Order
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Hóa đơn #ORD-@Model.Id.ToString("D3")</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: white; color: black; }
        .invoice-container { max-width: 800px; margin: 0 auto; padding: 20px; }
        .invoice-header { text-align: center; margin-bottom: 20px; border-bottom: 2px solid #000; padding-bottom: 10px; }
        .invoice-details { margin-bottom: 20px; }
        .table th, .table td { border-color: #000 !important; }
        @@media print {
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    <div class="invoice-container" id="invoice-content">
        <div class="no-print text-center mb-4">
            <button class="btn btn-primary" onclick="window.print()"><i class="fa-solid fa-print"></i> In hóa đơn</button>
            <button class="btn btn-danger" onclick="exportPDF()"><i class="fa-solid fa-file-pdf"></i> Tải PDF</button>
            <a href="javascript:history.back()" class="btn btn-secondary">Quay lại</a>
        </div>

        <div class="invoice-header">
            <h2>HÓA ĐƠN MUA HÀNG</h2>
            <p>Mã đơn hàng: <strong>#ORD-@Model.Id.ToString("D3")</strong></p>
            <p>Ngày đặt: @(Model.OrderDate == default ? "" : Model.OrderDate.ToString("dd/MM/yyyy HH:mm"))</p>
        </div>

        <div class="row invoice-details">
            <div class="col-6">
                <h5>Thông tin khách hàng:</h5>
                <p>
                    <strong>Khách hàng:</strong> @Model.CustomerName <br />
                    <strong>SĐT:</strong> @Model.Phone <br />
                    <strong>Địa chỉ:</strong> @Model.Address
                </p>
            </div>
            <div class="col-6 text-end">
                <h5>Thông tin thanh toán:</h5>
                <p>
                    <strong>Phương thức:</strong> @Model.PaymentMethod <br />
                    <strong>Trạng thái:</strong> @(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
                </p>
            </div>
        </div>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Tên sản phẩm</th>
                    <th class="text-center">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null)
                {
                    int stt = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@stt</td>
                            <td>@item.Name</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.Price.ToString("N0") ₫</td>
                            <td class="text-end">@(item.Price * item.Quantity) ₫</td>
                        </tr>
                        stt++;
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                    <td class="text-end fw-bold text-danger">@Model.TotalAmount.ToString("N0") ₫</td>
                </tr>
            </tfoot>
        </table>

        <div class="text-center mt-5">
            <p>Cảm ơn quý khách đã mua hàng!</p>
        </div>
    </div>
    
    <script>
        // Hàm xuất PDF
        function exportPDF() {
            var element = document.getElementById('invoice-content');
            var opt = {
              margin:       0.5,
              filename:     'HoaDon_ORD_@(Model.Id.ToString("D3")).pdf',
              image:        { type: 'jpeg', quality: 0.98 },
              html2canvas:  { scale: 2 },
              jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            // Ẩn các nút bấm trước khi tạo PDF
            var noPrintElements = document.querySelectorAll('.no-print');
            noPrintElements.forEach(el => el.style.display = 'none');

            html2pdf().set(opt).from(element).save().then(() => {
                // Hiển thị lại các nút bấm
                noPrintElements.forEach(el => el.style.display = 'block');
            });
        }
    </script>
</body>
</html>
