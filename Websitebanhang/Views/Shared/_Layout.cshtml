@using Microsoft.AspNetCore.Identity
@using Websitebanhang.Models
@using Microsoft.Extensions.Localization
@using Websitebanhang.Resources
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> Localizer

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Aura Coffee</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

<!-- NAVBAR -->
<nav id="mainNavbar" class="navbar navbar-expand-lg navbar-custom">
    <div class="container">

        <!-- LOGO -->
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            ☕ Aura Coffee
        </a>

        <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- MENU -->
        <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link">@Localizer["Home"]</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link">@Localizer["Product"]</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link">@Localizer["Category"]</a>
                </li>
            </ul>
        </div>

        <!-- RIGHT -->
        <div class="d-flex align-items-center gap-3">

            <!-- LANGUAGE -->
            <select id="langSelect" class="form-select form-select-sm" style="width:120px;">
                <option value="vi">🇻🇳 VI</option>
                <option value="en">🇺🇸 EN</option>
                <option value="fr">🇫🇷 FR</option>
                <option value="ja">🇯🇵 JP</option>
                <option value="ko">🇰🇷 KR</option>
                <option value="zh-CN">🇨🇳 CN</option>
            </select>

            <!-- DARK MODE -->
            <button id="themeToggle" class="btn btn-sm btn-outline-secondary">
                <span id="themeIcon">🌙</span>
            </button>

            <!-- LOGIN -->
            @if (SignInManager.IsSignedIn(User))
            {
                var user = await UserManager.GetUserAsync(User);
                <span>@(user?.UserName ?? "Guest")</span>
            }
            else
            {
                <a class="btn btn-outline-dark" asp-controller="Account" asp-action="Login">
                    @Localizer["Login"]
                </a>
            }
        </div>
    </div>
</nav>

<!-- BODY -->
<main class="container mt-4">
    @RenderBody()
</main>

<!-- FOOTER -->
<footer class="text-center mt-5 p-4 bg-dark text-white">
    <p>@Localizer["FooterText"]</p>
</footer>

<!-- JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- DARK MODE -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("themeToggle");
        const icon = document.getElementById("themeIcon");

        function setTheme(theme) {
            if (theme === "dark") {
                document.body.classList.add("dark-mode");
                icon.textContent = "☀️";
            } else {
                document.body.classList.remove("dark-mode");
                icon.textContent = "🌙";
            }
        }

        const saved = localStorage.getItem("theme") || "light";
        setTheme(saved);

        btn.addEventListener("click", function () {
            const newTheme = document.body.classList.contains("dark-mode") ? "light" : "dark";
            setTheme(newTheme);
            localStorage.setItem("theme", newTheme);
        });
    });
</script>

<!-- LANGUAGE -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const langSelect = document.getElementById("langSelect");

        function getCurrentCulture() {
            const match = document.cookie.match(/\.AspNetCore\.Culture=c=([^|]+)/);
            return match ? match[1] : "vi";
        }

        langSelect.value = getCurrentCulture();

        langSelect.addEventListener("change", function () {
            const lang = this.value;
            document.cookie = `.AspNetCore.Culture=c=${lang}|uic=${lang}; path=/`;
            location.reload();
        });
    });
</script>

@RenderSection("Scripts", required: false)

</body>
</html>