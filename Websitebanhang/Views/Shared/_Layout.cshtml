<!DOCTYPE html>
<html lang="vi">
<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Coffee Shop</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-black shadow-sm">

<div class="container">

<!-- LOGO -->
<a class="navbar-brand fw-bold"
   asp-controller="Home"
   asp-action="Index">
☕ Coffee Shop
</a>

<!-- MOBILE BUTTON -->
<button class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav">
<span class="navbar-toggler-icon"></span>
</button>

<!-- MENU -->
<div class="collapse navbar-collapse" id="navbarNav">

<ul class="navbar-nav me-auto">

<li class="nav-item">
<a class="nav-link"
   asp-controller="Home"
   asp-action="Index">
Trang Chủ
</a>
</li>

<li class="nav-item">
<a class="nav-link"
   asp-controller="Product"
   asp-action="Index">
Cà Phê
</a>
</li>

<li class="nav-item">
<a class="nav-link"
   asp-controller="Category"
   asp-action="Index">
Danh Mục
</a>
</li>

<!-- ADMIN MENU -->
@if (User.IsInRole("Admin"))
{
    <li class="nav-item dropdown">

    <a class="nav-link dropdown-toggle"
       href="#"
       role="button"
       data-bs-toggle="dropdown">

    Quản trị

    </a>

    <ul class="dropdown-menu">

    <li>
    <a class="dropdown-item"
       asp-controller="Admin"
       asp-action="Index">
    Bảng điều khiển
    </a>
    </li>

    <li>
    <a class="dropdown-item"
       asp-controller="Product"
       asp-action="Index">
    Quản lý sản phẩm
    </a>
    </li>

    <li>
    <a class="dropdown-item"
       asp-controller="Order"
       asp-action="Index">
    Quản lý đơn hàng
    </a>
    </li>

    <li>
    <a class="dropdown-item"
       asp-controller="User"
       asp-action="Index">
    Quản lý người dùng
    </a>
    </li>

    </ul>

    </li>
}

</ul>

<!-- CART -->
<a asp-controller="Cart"
   asp-action="Index"
   class="btn btn-outline-light me-3">

<i class="fa fa-shopping-cart"></i>
Giỏ Hàng

</a>

<!-- LOGIN / REGISTER / LOGOUT -->
<ul class="navbar-nav">

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
    <li class="nav-item dropdown">
    <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
    <i class="fa fa-user me-1"></i> Xin chào, @User.Identity.Name
    </a>
    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa fa-id-card me-2"></i>Hồ sơ của tôi</a></li>
        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa fa-key me-2"></i>Đổi mật khẩu</a></li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                <button type="submit" class="dropdown-item text-danger">
                    <i class="fa fa-sign-out-alt me-2"></i>Đăng xuất
                </button>
            </form>
        </li>
    </ul>
    </li>
}
else
{
    <li class="nav-item">
    <a class="nav-link"
       asp-controller="Account"
       asp-action="Login">

    <i class="fa fa-sign-in-alt me-1"></i>
    Đăng nhập

    </a>
    </li>

    <li class="nav-item">
    <a class="nav-link"
       asp-controller="Account"
       asp-action="Register">

    Đăng ký

    </a>
    </li>
}

</ul>

</div>

</div>

</nav>

<!-- BODY -->
<main class="container mt-4">
@RenderBody()
</main>

<!-- FOOTER -->
<footer class="bg-black text-white text-center mt-5 p-4">

<div class="container">

<p class="mb-2 fs-5">
☕ Coffee Shop - Premium Roasted Coffee
</p>

<p class="mb-1">
Fresh Beans • Quality Coffee • Perfect Taste
</p>

<p class="mb-0">
© 2025 Coffee Store
</p>

</div>

</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

</body>
</html>