@using Microsoft.AspNetCore.Identity
@using Websitebanhang.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Websitebanhang.Services.IWebsiteSettingService SettingService
@{
    var logoUrl = await SettingService.GetSettingAsync("Logo", "/images/logo.png");
    var siteTitle = await SettingService.GetSettingAsync("SiteTitle", "Aura Coffee");
    var hotline = await SettingService.GetSettingAsync("Hotline", "0344.506.553");
    var email = await SettingService.GetSettingAsync("Email", "support@auracoffee.com");
    var address = await SettingService.GetSettingAsync("Address", "123 Đường Cà Phê, TP. Hồ Chí Minh");
    var facebook = await SettingService.GetSettingAsync("Facebook", "#");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @siteTitle</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <!-- Toastify CSS -->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

    @RenderSection("Styles", required: false)
    <style>
        .search-suggestions {
            position: absolute;
            top: 100%;
            left: 0;
            width: 100%;
            background: white;
            border-radius: 10px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            z-index: 1050;
            margin-top: 5px;
            display: none;
            overflow: hidden;
        }
        .search-suggestion-item {
            padding: 10px 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #333;
            transition: background 0.2s;
        }
        .search-suggestion-item:hover {
            background: #f8f9fa;
        }
        .search-suggestion-img {
            width: 40px;
            height: 40px;
            object-fit: cover;
            border-radius: 5px;
        }
        .search-suggestion-info {
            flex-grow: 1;
        }
        .search-suggestion-name {
            font-weight: 500;
            margin-bottom: 0;
            font-size: 0.9rem;
        }
        .search-suggestion-price {
            font-size: 0.8rem;
            color: #6c757d;
        }
        .dark-mode .search-suggestions {
            background: #2d2d2d;
            border: 1px solid #444;
        }
        .dark-mode .search-suggestion-item {
            color: #eee;
        }
        .dark-mode .search-suggestion-item:hover {
            background: #3d3d3d;
        }
    </style>
</head>

<body>

<!-- STICKY NAVBAR -->
<nav id="mainNavbar" class="navbar navbar-expand-lg navbar-custom">
    <div class="container d-flex align-items-center">
        <!-- LOGO -->
        <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
            <img src="@logoUrl" alt="Logo" style="height: 45px; width: auto;" onerror="this.onerror=null; this.style.display='none'; document.getElementById('logoFallback').style.display='flex';" />
            <div id="logoFallback" class="d-none align-items-center gap-2">
                <i class="fa-solid fa-mug-hot text-gold fs-3"></i>
                <span>@siteTitle</span>
            </div>
        </a>

        <!-- MOBILE BUTTON -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- MENU (CENTER) -->
        <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Product" asp-action="Index">Hạt Cà Phê</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Category" asp-action="Index">Danh Mục</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên Hệ</a>
                </li>
            </ul>
        </div>

        <!-- RIGHT ACTIONS -->
        <div class="d-none d-lg-flex align-items-center gap-3">
            
            <!-- Search -->
            <form class="d-flex position-relative" id="mainSearchForm" action="/Product/Index" method="get" autocomplete="off">
                <input type="text" id="searchInput" name="search" class="form-control rounded-pill pe-5 bg-light border-0 search-input" placeholder="Tìm kiếm..." style="width: 150px;">
                <button type="submit" class="btn position-absolute end-0 top-50 translate-middle-y text-muted border-0"><i class="fa-solid fa-magnifying-glass"></i></button>
                <div id="searchSuggestions" class="search-suggestions"></div>
            </form>

            <!-- Compare -->
            <a asp-controller="Compare" asp-action="Index" class="text-primary fs-5 ms-2" title="So sánh sản phẩm">
                <i class="fa-solid fa-code-compare"></i>
            </a>

            <!-- Wishlist -->
            <a asp-controller="Wishlist" asp-action="Index" class="text-danger fs-5 ms-2 me-2" title="Danh mục yêu thích">
                <i class="fa-regular fa-heart"></i>
            </a>

            <!-- Multi-Language Wrapper -->
            <div class="language-wrapper me-1">
                <partial name="_SelectLanguagePartial" />
            </div>

            <!-- Cart -->
            <a asp-controller="Cart" asp-action="Index" class="text-dark fs-5 cart-icon-wrapper" title="Giỏ hàng">
                <i class="fa-solid fa-basket-shopping"></i>
                <span class="cart-badge shadow-sm">0</span>
            </a>

            <!-- Theme toggle -->
            <button id="themeToggle" class="btn btn-outline-secondary rounded-circle" title="Chế độ tối" style="width:38px;height:38px;">
                <i id="themeIcon" class="fa-solid fa-moon"></i>
            </button>

            <!-- Avatar / Login -->
            <ul class="navbar-nav m-0 p-0">
            @if (SignInManager.IsSignedIn(User))
            {
                var currentUser = await UserManager.GetUserAsync(User);
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 p-0" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                        {
                            <img src="@currentUser.AvatarUrl" alt="Avatar" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-coffee text-white d-flex align-items-center justify-content-center shadow-sm" style="width: 38px; height: 38px;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2" aria-labelledby="userDropdown">
                        <li class="px-3 py-2 text-muted small">Xin chào, <strong>@User.Identity?.Name</strong></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="fa-regular fa-id-badge me-2 text-coffee"></i>Hồ sơ</a></li>
                        <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="fa-solid fa-shield-halved me-2 text-coffee"></i>Đổi mật khẩu</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-user-gear me-2 text-primary"></i>Quản trị hệ thống</a></li>
                        }
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 p-0">
                                <button type="submit" class="dropdown-item text-danger">
                                    <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Đăng xuất
                                </button>
                            </form>
                        </li>
                    </ul>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <a class="btn btn-outline-dark rounded-pill px-4 btn-sm fw-medium" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                </li>
            }
            </ul>
        </div>
    </div>
</nav>

<!-- BODY -->
<main class="container mt-5 mb-5 pb-5">
    @RenderBody()
</main>

<!-- FOOTER -->
<footer class="footer-custom">
    <div class="container">
        <div class="row gy-4">
            <div class="col-md-4 text-center text-md-start">
                <a class="d-flex align-items-center gap-2 justify-content-center justify-content-md-start text-white mb-3" asp-controller="Home" asp-action="Index">
                    <img src="@logoUrl" alt="Logo" style="height: 40px; width: auto; filter: brightness(0) invert(1);" onerror="this.style.display='none';" />
                    <span class="fs-4 fw-bold">@siteTitle</span>
                </a>
                <p class="small text-white-50">Mang đến trải nghiệm cà phê nguyên bản, đậm vị và đầy cảm hứng cho người Việt.</p>
                <div class="small text-white-50 mt-2">
                    <i class="fa-solid fa-location-dot me-2"></i> @address <br/>
                    <i class="fa-solid fa-phone me-2"></i> @hotline <br/>
                    <i class="fa-solid fa-envelope me-2"></i> @email
                </div>
            </div>
            <div class="col-md-4 text-center">
                <h5 class="text-gold mb-3">Liên Kết</h5>
                <ul class="list-unstyled d-flex flex-column gap-2">
                    <li><a href="/">Trang Chủ</a></li>
                    <li><a href="/Product">Hạt Cà Phê</a></li>
                    <li><a href="/Home/Contact">Liên Hệ</a></li>
                </ul>
            </div>
            <div class="col-md-4 text-center text-md-end">
                <h5 class="text-gold mb-3">Kết Nối</h5>
                <div class="d-flex justify-content-center justify-content-md-end gap-3 fs-4">
                    <a href="@facebook" target="_blank"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-tiktok"></i></a>
                </div>
                <p class="small text-white-50 mt-3 mb-0">© @DateTime.Now.Year @siteTitle. All Rights Reserved.</p>
            </div>
        </div>
    </div>
</footer>

<!-- ZALO CHAT BUTTON -->
<a href="https://zalo.me/@hotline.Replace(".", "").Replace(" ", "")" target="_blank" class="zalo-float" title="Chat với shop qua Zalo">
    <img src="https://upload.wikimedia.org/wikipedia/commons/9/91/Icon_of_Zalo.svg" alt="Zalo Logo">
</a>

<!-- BACK TO TOP BUTTON -->
<button id="backToTop" title="Lên đầu trang"><i class="fa-solid fa-arrow-up"></i></button>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- Scripts for Sticky Navbar & BackToTop -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const navbar = document.getElementById("mainNavbar");
        const backToTopBtn = document.getElementById("backToTop");

        window.addEventListener("scroll", function() {
            // Sticky Navbar
            if (window.scrollY > 50) {
                navbar.classList.add("sticky");
            } else {
                navbar.classList.remove("sticky");
            }

            // Back To Top Button
            if (window.scrollY > 300) {
                backToTopBtn.style.display = "flex";
            } else {
                backToTopBtn.style.display = "none";
            }
        });

        // Smooth scroll to top
        backToTopBtn.addEventListener("click", function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        // Theme toggle
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');

        function applyTheme(dark) {
            if (dark) {
                document.body.classList.add('dark-mode');
                themeIcon.classList.remove('fa-moon');
                themeIcon.classList.add('fa-sun');
            } else {
                document.body.classList.remove('dark-mode');
                themeIcon.classList.remove('fa-sun');
                themeIcon.classList.add('fa-moon');
            }
        }

        // Load preference from localStorage
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') applyTheme(true);
        else if (stored === 'light') applyTheme(false);
        else {
            // follow OS preference
            const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            applyTheme(prefersDark);
        }

        themeToggle?.addEventListener('click', function() {
            const isDark = document.body.classList.toggle('dark-mode');
            applyTheme(isDark);
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        });
    });
</script>

@RenderSection("Scripts", required: false)

<!-- SignalR & Toastify -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
<script src="~/js/notification.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        @if (TempData["Success"] != null)
        {
            <text>
            Toastify({
                text: "@TempData["Success"]",
                duration: 5000,
                gravity: "top",
                position: "right",
                style: { background: "linear-gradient(to right, #00b09b, #96c93d)" }
            }).showToast();
            </text>
        }
        @if (TempData["Error"] != null)
        {
            <text>
            Toastify({
                text: "@TempData["Error"]",
                duration: 5000,
                gravity: "top",
                position: "right",
                style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)" }
            }).showToast();
            </text>
        }
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const searchInput = document.getElementById('searchInput');
        const suggestionsBox = document.getElementById('searchSuggestions');
        let debounceTimer;

        if (searchInput && suggestionsBox) {
            searchInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                const term = this.value.trim();

                if (term.length < 2) {
                    suggestionsBox.style.display = 'none';
                    return;
                }

                debounceTimer = setTimeout(() => {
                    fetch(`/Product/SearchSuggestions?term=${encodeURIComponent(term)}`)
                        .then(response => response.json())
                        .then(data => {
                            if (data.length > 0) {
                                suggestionsBox.innerHTML = data.map(item => `
                                    <a href="/Product/Display/${item.id}" class="search-suggestion-item">
                                        <img src="${item.imageUrl || '/images/default-coffee.jpg'}" class="search-suggestion-img" alt="${item.name}">
                                        <div class="search-suggestion-info">
                                            <p class="search-suggestion-name">${item.name}</p>
                                            <span class="search-suggestion-price">${item.price.toLocaleString()} ₫</span>
                                        </div>
                                    </a>
                                `).join('');
                                suggestionsBox.style.display = 'block';
                            } else {
                                suggestionsBox.style.display = 'none';
                            }
                        })
                        .catch(err => console.error('Search error:', err));
                }, 300);
            });

            // Hide suggestions when clicking outside
            document.addEventListener('click', function(e) {
                if (!searchInput.contains(e.target) && !suggestionsBox.contains(e.target)) {
                    suggestionsBox.style.display = 'none';
                }
            });
        }
    });
</script>

</body>
</html>