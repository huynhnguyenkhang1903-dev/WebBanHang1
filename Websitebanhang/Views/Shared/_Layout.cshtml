<!DOCTYPE html>
<html lang="vi">
<head>

    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Coffee Shop</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-expand-lg navbar-dark bg-black shadow-sm">

<div class="container">

<!-- LOGO -->
<a class="navbar-brand fw-bold"
   asp-controller="Home"
   asp-action="Index">
☕ Coffee Shop
</a>

<!-- MOBILE BUTTON -->
<button class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarNav">
<span class="navbar-toggler-icon"></span>
</button>

<!-- MENU -->
<div class="collapse navbar-collapse" id="navbarNav">

<ul class="navbar-nav me-auto">

<li class="nav-item">
<a class="nav-link"
   asp-controller="Home"
   asp-action="Index">
Home
</a>
</li>

<li class="nav-item">
<a class="nav-link"
   asp-controller="Product"
   asp-action="Index">
Coffee
</a>
</li>

<li class="nav-item">
<a class="nav-link"
   asp-controller="Category"
   asp-action="Index">
Category
</a>
</li>

<!-- ADMIN MENU -->
<li class="nav-item dropdown">

<a class="nav-link dropdown-toggle"
   href="#"
   role="button"
   data-bs-toggle="dropdown">

Admin

</a>

<ul class="dropdown-menu">

<li>
<a class="dropdown-item"
   asp-controller="Product"
   asp-action="Index">
Quản lý sản phẩm
</a>
</li>

<li>
<a class="dropdown-item"
   asp-controller="Order"
   asp-action="Index">
Quản lý đơn hàng
</a>
</li>

<li>
<a class="dropdown-item"
   asp-controller="User"
   asp-action="Index">
Quản lý người dùng
</a>
</li>

</ul>

</li>

</ul>

<!-- CART -->
<a asp-controller="Cart"
   asp-action="Index"
   class="btn btn-outline-light me-3">

<i class="fa fa-shopping-cart"></i>
Cart

</a>

<!-- LOGIN / REGISTER -->
<ul class="navbar-nav">

<li class="nav-item">
<a class="nav-link"
   asp-controller="Login"
   asp-action="Login">

<i class="fa fa-user"></i>
Login

</a>
</li>

<li class="nav-item">
<a class="nav-link"
   asp-controller="Login"
   asp-action="Register">

Register

</a>
</li>

</ul>

</div>

</div>

</nav>

<!-- BODY -->
<main class="container mt-4">
@RenderBody()
</main>

<!-- FOOTER -->
<footer class="bg-black text-white text-center mt-5 p-4">

<div class="container">

<p class="mb-2 fs-5">
☕ Coffee Shop - Premium Roasted Coffee
</p>

<p class="mb-1">
Fresh Beans • Quality Coffee • Perfect Taste
</p>

<p class="mb-0">
© 2025 Coffee Store
</p>

</div>

</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

@RenderSection("Scripts", required: false)

</body>
</html>