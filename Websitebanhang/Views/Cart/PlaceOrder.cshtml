@model List<Websitebanhang.Models.CartItem>
@using System.Globalization
@inject Microsoft.AspNetCore.Identity.UserManager<Websitebanhang.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "X�c nh?n ??n h�ng";
    var user = await UserManager.GetUserAsync(User);
    decimal total = Model?.Sum(i => i.Price * i.Quantity) ?? 0m;
}

<div class="row fade-in">
    <div class="col-md-8 mx-auto">
        <div class="bg-white p-4 rounded-4 shadow-sm">
            <h3 class="mb-3 text-coffee">X�c nh?n ??n h�ng</h3>

            <form asp-controller="Cart" asp-action="PlaceOrder" method="post">
                <div class="row g-3">
                    @{
                        var addresses = ViewBag.UserAddresses as List<Websitebanhang.Models.UserAddress>;
                        if (addresses != null && addresses.Any())
                        {
                            <div class="col-12 mb-3">
                                <label class="form-label fw-bold">Chọn từ sổ địa chỉ</label>
                                <select class="form-select border-warning" id="savedAddressSelect" onchange="fillAddressForm()">
                                    <option value="">-- Nhập địa chỉ mới bên dưới --</option>
                                    @foreach (var addr in addresses)
                                    {
                                        if (addr.IsDefault)
                                        {
                                            <option value="@addr.Id" data-name="@addr.FullName" data-phone="@addr.PhoneNumber" data-address="@addr.AddressLine" selected>
                                                [Mặc định] @addr.FullName - @addr.PhoneNumber - @addr.AddressLine
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@addr.Id" data-name="@addr.FullName" data-phone="@addr.PhoneNumber" data-address="@addr.AddressLine">
                                                @addr.FullName - @addr.PhoneNumber - @addr.AddressLine
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                    }

                    <div class="col-md-6 form-floating">
                        <input type="text" name="name" class="form-control" id="name" value="@user?.FullName" required />
                        <label for="name">H? v� t�n</label>
                    </div>
                    <div class="col-md-6 form-floating">
                        <input type="email" name="email" class="form-control" id="email" value="@user?.Email" required />
                        <label for="email">Email</label>
                    </div>
                    <div class="col-12 form-floating">
                        <input type="text" name="address" class="form-control" id="address" value="@user?.Address" required />
                        <label for="address">??a ch? giao h�ng</label>
                    </div>
                    <div class="col-md-6 form-floating">
                        <input type="tel" name="phone" class="form-control" id="phone" value="@user?.PhoneNumber" required />
                        <label for="phone">Số điện thoại</label>
                    </div>
                    <div class="col-12 form-floating">
                        <textarea name="orderNotes" class="form-control" id="orderNotes" style="height: 100px"></textarea>
                        <label for="orderNotes">Ghi chú đơn hàng (tuỳ chọn)</label>
                    </div>

                    <div class="col-12">
                        <h5 class="text-coffee">S?n ph?m</h5>
                        <div class="list-group mb-3">
                            @foreach (var item in Model ?? new List<Websitebanhang.Models.CartItem>())
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold">@item.Name</div>
                                        <small class="text-secondary">Số lượng: @item.Quantity</small>
                                    </div>
                                    <div class="fw-bold">@((item.Price * item.Quantity).ToString("N0", CultureInfo.CurrentCulture)) ₫</div>
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Đơn vị vận chuyển</label>
                            <select name="shippingProvider" id="shippingProvider" class="form-select border-info" required onchange="calculateTotal()">
                                <option value="GHTK" data-cost="15000" selected>Giao Hàng Tiết Kiệm (15.000 ₫)</option>
                                <option value="Viettel Post" data-cost="20000">Viettel Post (20.000 ₫)</option>
                                <option value="GHN" data-cost="25000">Giao Hàng Nhanh (25.000 ₫)</option>
                                <option value="Hỏa tốc" data-cost="50000">Giao Hỏa Tốc (50.000 ₫)</option>
                            </select>
                        </div>

                        @if (user != null && user.RewardPoints > 0)
                        {
                            <div class="form-check form-switch mb-3 p-3 bg-light rounded-3 border">
                                <input class="form-check-input ms-0 me-2" type="checkbox" name="usePoints" id="usePoints" onchange="calculateTotal()" value="true">
                                <label class="form-check-label fw-bold text-coffee" for="usePoints">
                                    <i class="fa-solid fa-coins text-warning me-1"></i> Sử dụng điểm thưởng (@user.RewardPoints.ToString("N0") điểm)
                                </label>
                                <div class="small text-muted mt-1">
                                    Dùng @user.RewardPoints.ToString("N0") điểm để được giảm <strong>@((user.RewardPoints * 100).ToString("N0")) ₫</strong>
                                </div>
                            </div>
                        }

                        <!-- VOUCHER -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mã giảm giá đơn hàng</label>
                                <div class="input-group">
                                    <input type="text" name="voucherCode" id="voucherCode" class="form-control border-warning" placeholder="Nhập mã...">
                                    <button type="button" class="btn btn-warning" onclick="applyVoucher('order')">Áp dụng</button>
                                </div>
                                <div id="voucherMsg" class="small mt-1"></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Mã giảm phí vận chuyển</label>
                                <div class="input-group">
                                    <input type="text" name="shippingVoucherCode" id="shippingVoucherCode" class="form-control border-info" placeholder="Nhập mã...">
                                    <button type="button" class="btn btn-info text-white" onclick="applyVoucher('shipping')">Áp dụng</button>
                                </div>
                                <div id="shippingVoucherMsg" class="small mt-1"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="text-secondary">Tạm tính:</div>
                            <div class="fw-bold" id="subTotalDisplay" data-value="@total">@total.ToString("N0", CultureInfo.CurrentCulture) ₫</div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <div class="text-secondary">Phí vận chuyển:</div>
                            <div class="fw-bold text-info" id="shippingCostDisplay">15.000 ₫</div>
                        </div>
                        
                        <div id="orderDiscountRow" class="d-flex justify-content-between align-items-center mb-2 d-none">
                            <div class="text-secondary">Giảm giá đơn hàng (<span id="orderDiscountPercent">0</span>%):</div>
                            <div class="fw-bold text-danger" id="orderDiscountDisplay">-0 ₫</div>
                        </div>

                        <div id="shippingDiscountRow" class="d-flex justify-content-between align-items-center mb-2 d-none">
                            <div class="text-secondary">Giảm phí vận chuyển (<span id="shippingDiscountPercent">0</span>%):</div>
                            <div class="fw-bold text-danger" id="shippingDiscountDisplay">-0 ₫</div>
                        </div>

                        <div id="pointsDiscountRow" class="d-flex justify-content-between align-items-center mb-2 d-none">
                            <div class="text-secondary">Giảm giá điểm thưởng:</div>
                            <div class="fw-bold text-danger" id="pointsDiscountDisplay">-0 ₫</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4 border-top pt-2">
                            <div class="fw-bold fs-5">Tổng cộng:</div>
                            <div class="fw-bold text-gold fs-4" id="finalTotalDisplay">@((total + 15000).ToString("N0", CultureInfo.CurrentCulture)) ₫</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Phương thức thanh toán</label>
                            <select name="paymentMethod" class="form-select" required>
                                <option value="COD">Thanh toán khi nhận hàng (COD)</option>
                                <option value="bank">Chuyển khoản ngân hàng</option>
                                <option value="VNPay">VNPay</option>
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary-custom">Xác nhận đặt hàng</button>
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark">Quay lại giỏ hàng</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function fillAddressForm() {
        var select = document.getElementById('savedAddressSelect');
        if (!select) return;
        
        var option = select.options[select.selectedIndex];
        if (option.value) {
            document.getElementById('name').value = option.getAttribute('data-name');
            document.getElementById('phone').value = option.getAttribute('data-phone');
            document.getElementById('address').value = option.getAttribute('data-address');
        } else {
            // Clear input so user can type new one
            document.getElementById('name').value = '@(user?.FullName)';
            document.getElementById('phone').value = '@(user?.PhoneNumber)';
            document.getElementById('address').value = '@(user?.Address)';
        }
    }

    var orderDiscountPercent = 0;
    var shippingDiscountPercent = 0;

    function applyVoucher(type) {
        var code = "";
        var msgId = "";
        
        if (type === 'order') {
            code = document.getElementById('voucherCode').value;
            msgId = 'voucherMsg';
        } else {
            code = document.getElementById('shippingVoucherCode').value;
            msgId = 'shippingVoucherMsg';
        }

        if (!code) {
            document.getElementById(msgId).innerHTML = '<span class="text-danger">Vui lòng nhập mã!</span>';
            return;
        }

        fetch('/Cart/ValidateVoucher?code=' + encodeURIComponent(code))
            .then(response => response.json())
            .then(data => {
                var msgEl = document.getElementById(msgId);
                if (data.success) {
                    msgEl.innerHTML = '<span class="text-success"><i class="fa-solid fa-check"></i> ' + data.message + '</span>';
                    if (type === 'order') {
                        orderDiscountPercent = data.discountPercent;
                    } else {
                        shippingDiscountPercent = data.discountPercent;
                    }
                    calculateTotal();
                } else {
                    msgEl.innerHTML = '<span class="text-danger"><i class="fa-solid fa-xmark"></i> ' + data.message + '</span>';
                    if (type === 'order') {
                        orderDiscountPercent = 0;
                    } else {
                        shippingDiscountPercent = 0;
                    }
                    calculateTotal();
                }
            });
    }

    function calculateTotal() {
        var subTotal = parseFloat(document.getElementById('subTotalDisplay').getAttribute('data-value')) || 0;
        var select = document.getElementById('shippingProvider');
        var option = select.options[select.selectedIndex];
        var shippingCost = parseFloat(option.getAttribute('data-cost')) || 0;

        document.getElementById('shippingCostDisplay').innerText = new Intl.NumberFormat('vi-VN').format(shippingCost) + ' ₫';
        
        // 1. Order Voucher Discount
        var orderDiscount = Math.round(subTotal * (orderDiscountPercent / 100));
        if (orderDiscount > 0) {
            document.getElementById('orderDiscountRow').classList.remove('d-none');
            document.getElementById('orderDiscountPercent').innerText = orderDiscountPercent;
            document.getElementById('orderDiscountDisplay').innerText = '-' + new Intl.NumberFormat('vi-VN').format(orderDiscount) + ' ₫';
        } else {
            document.getElementById('orderDiscountRow').classList.add('d-none');
        }

        // 2. Shipping Voucher Discount
        var shippingDiscount = Math.round(shippingCost * (shippingDiscountPercent / 100));
        if (shippingDiscount > 0) {
            document.getElementById('shippingDiscountRow').classList.remove('d-none');
            document.getElementById('shippingDiscountPercent').innerText = shippingDiscountPercent;
            document.getElementById('shippingDiscountDisplay').innerText = '-' + new Intl.NumberFormat('vi-VN').format(shippingDiscount) + ' ₫';
        } else {
            document.getElementById('shippingDiscountRow').classList.add('d-none');
        }

        // 3. Points Discount
        var pointsDiscount = 0;
        var usePointsCheckbox = document.getElementById('usePoints');
        if (usePointsCheckbox && usePointsCheckbox.checked) {
            var userPoints = @(user?.RewardPoints ?? 0);
            pointsDiscount = userPoints * 100;
            
            // Limit discount to subTotal - orderDiscount
            var maxPointsDiscount = subTotal - orderDiscount;
            if (pointsDiscount > maxPointsDiscount) pointsDiscount = maxPointsDiscount;
            
            document.getElementById('pointsDiscountRow').classList.remove('d-none');
            document.getElementById('pointsDiscountDisplay').innerText = '-' + new Intl.NumberFormat('vi-VN').format(pointsDiscount) + ' ₫';
        } else {
            if(document.getElementById('pointsDiscountRow')) {
                document.getElementById('pointsDiscountRow').classList.add('d-none');
            }
        }

        var finalTotal = subTotal - orderDiscount - pointsDiscount + Math.max(0, shippingCost - shippingDiscount);
        document.getElementById('finalTotalDisplay').innerText = new Intl.NumberFormat('vi-VN').format(finalTotal) + ' ₫';
    }

    // Auto-fill on load if default is selected
    window.addEventListener('DOMContentLoaded', function() {
        var select = document.getElementById('savedAddressSelect');
        if (select && select.value) {
            fillAddressForm();
        }
        calculateTotal();
    });
</script>
