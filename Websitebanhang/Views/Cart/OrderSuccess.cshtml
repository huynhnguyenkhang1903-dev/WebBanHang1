@model Websitebanhang.Models.Order
@{
    ViewData["Title"] = "Đặt Hàng Thành Công";
}

@if (TempData["Debug_CartHtml"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-secondary">
            <strong>Debug Cart:</strong>
            @Html.Raw(TempData["Debug_CartHtml"]?.ToString())
        </div>
    </div>
}

@if (TempData["Debug_Subtotal"] != null)
{
    <div class="container mt-3">
        <div class="alert alert-info">
            <strong>Debug Totals:</strong>
            <ul class="mb-0">
                <li>Subtotal: @TempData["Debug_Subtotal"]</li>
                <li>Order Discount: @TempData["Debug_OrderDiscount"]</li>
                <li>Shipping Cost: @TempData["Debug_ShippingCost"]</li>
                <li>Shipping Discount: @TempData["Debug_ShippingDiscount"]</li>
                <li>Final Total: @TempData["Debug_FinalTotal"]</li>
            </ul>
        </div>
    </div>
}

<div class="row align-items-center justify-content-center fade-in mt-5 mb-5">
    <!-- STEP INDICATOR -->
    <div class="col-12 mb-5">
        <div class="step-indicator" style="max-width: 600px; margin: 0 auto;">
            <div class="step active">
                <div class="step-circle"><i class="fa-solid fa-check"></i></div>
                <div class="small fw-medium text-coffee">Giỏ Hàng</div>
            </div>
            <div class="step active">
                <div class="step-circle"><i class="fa-solid fa-check"></i></div>
                <div class="small fw-medium text-coffee">Thanh Toán</div>
            </div>
            <div class="step active">
                <div class="step-circle bg-success shadow-none"><i class="fa-solid fa-check"></i></div>
                <div class="small fw-bold text-success">Hoàn Tất</div>
            </div>
        </div>
    </div>

    <div class="col-md-8 col-lg-6">
        <div class="bg-white p-5 rounded-4 shadow-lg text-center position-relative overflow-hidden">
            <!-- Background decoration -->
            <div class="position-absolute top-0 start-0 w-100 bg-success" style="height: 10px;"></div>

            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10" style="width: 100px; height: 100px;">
                    <i class="fa-solid fa-check text-success" style="font-size: 3.5rem;"></i>
                </div>
            </div>

            <h2 class="fw-bold text-dark mb-3">Đặt Hàng Thành Công!</h2>
            <p class="text-secondary fs-5 mb-4">Cảm ơn bạn đã tin tưởng Aura Coffee. Đơn hàng của bạn đã được ghi nhận và đang được xử lý.</p>

            @if (Model != null)
            {
                <div class="bg-light p-4 rounded-4 text-start mb-4 border">
                    <h5 class="fw-bold text-coffee border-bottom pb-2 mb-3">Thông Tin Đơn Hàng #@Model.Id</h5>
                    
                    <div class="row mb-2">
                        <div class="col-5 text-secondary">Khách hàng:</div>
                        <div class="col-7 fw-medium text-dark text-break">@Model.CustomerName</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-secondary">Số điện thoại:</div>
                        <div class="col-7 fw-medium text-dark">@Model.Phone</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-secondary">Địa chỉ giao:</div>
                        <div class="col-7 fw-medium text-dark">@Model.Address</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-5 text-secondary">Thanh toán:</div>
                        <div class="col-7 fw-medium text-dark">
                            @if (Model.PaymentMethod == "COD")
                            {
                                <span class="badge bg-success">Nhận hàng (COD)</span>
                            }
                            else if (Model.PaymentMethod == "VNPay")
                            {
                                <span class="badge bg-info text-dark">VNPay</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">@Model.PaymentMethod</span>
                            }
                        </div>
                    </div>
                    <div class="row mt-3 pt-2 border-top">
                        <div class="col-5 fw-bold text-dark fs-5">Tổng tiền:</div>
                        <div class="col-7 fw-bold text-gold fs-5">@Model.TotalAmount.ToString("N0") ₫</div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.VoucherCode))
                    {
                        <div class="row mt-3">
                            <div class="col-12">
                                <div class="alert alert-success">
                                    <h6 class="mb-1">Mã giảm giá của bạn</h6>
                                    <div class="fw-bold">@Model.VoucherCode</div>
                                    <div class="small text-muted">Giảm @Model.VoucherDiscountPercent% - Hết hạn: @Model.VoucherExpires?.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4">
                <a asp-controller="Product" asp-action="Index" class="btn btn-outline-dark btn-lg rounded-pill px-4">
                    <i class="fa-solid fa-basket-shopping me-2"></i>Tiếp Tục Mua Sắm
                </a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-primary-custom btn-lg rounded-pill px-4">
                    <i class="fa-regular fa-file-lines me-2"></i>Xem Đơn Hàng
                </a>
            </div>
        </div>
    </div>
</div>
