@{
    ViewData["Title"] = "Thanh toán chuy?n kho?n";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center bg-white p-4 rounded shadow-sm">
            <h3 class="mb-3">Thanh toán b?ng chuy?n kho?n</h3>

            <p class="mb-1"><strong>S? ti?n:</strong> @ViewBag.Amount.ToString("N0") ?</p>
            <p class="mb-3"><strong>N?i dung chuy?n kho?n:</strong> <code>@ViewBag.Content</code></p>

            <div class="mb-4">
                <img src="@ViewBag.QRCode" alt="QR Thanh toán" class="img-fluid" style="max-width: 320px;" />
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <div class="card p-3">
                        <div class="small text-muted">Ngân hàng</div>
                        <div class="fw-bold">@ViewBag.BankCode</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <div class="small text-muted">S? tài kho?n</div>
                        <div class="fw-bold">@ViewBag.AccountNumber</div>
                        <button class="btn btn-sm btn-outline-secondary mt-2" onclick="copyText('@ViewBag.AccountNumber')">Sao chép</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3">
                        <div class="small text-muted">Ch? tài kho?n</div>
                        <div class="fw-bold">@ViewBag.AccountName</div>
                        <button class="btn btn-sm btn-outline-secondary mt-2" onclick="copyText('@ViewBag.AccountName')">Sao chép</button>
                    </div>
                </div>
            </div>

            <form asp-controller="Cart" asp-action="CheckPayment" method="get">
                <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
                <button type="submit" class="btn btn-success btn-lg me-2">Tôi ?ã chuy?n kho?n</button>
            </form>

            <form asp-controller="Cart" asp-action="Index" method="get" class="d-inline-block">
                <button type="submit" class="btn btn-outline-secondary btn-lg">Quay l?i c?a hàng</button>
            </form>

            <p class="small text-muted mt-3">L?u ý: Vui lòng nh?p ?úng <strong>n?i dung</strong> ?? h? th?ng ??i soát t? ??ng.</p>
        </div>
    </div>
</div>

<script>
    function copyText(text) {
        if (!text) return;
        navigator.clipboard?.writeText(text).then(function() {
            alert('?ã sao chép: ' + text);
        }).catch(function() {
            // fallback
            var temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            alert('?ã sao chép: ' + text);
        });
    }
</script>