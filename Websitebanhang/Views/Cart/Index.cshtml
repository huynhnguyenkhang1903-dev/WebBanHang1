@model List<CartItem>

<h2>Giỏ hàng</h2>

<table class="table">
    <thead>
        <tr>
            <th>Sản phẩm</th>
            <th>Giá</th>
            <th>Số lượng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Product?.Name</td>
                <td>@item.Product?.Price</td>
                <td>@item.Quantity</td>
            </tr>
        }
    </tbody>
</table>