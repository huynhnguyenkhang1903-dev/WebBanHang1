@model List<Websitebanhang.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng";
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item active" aria-current="page">Giỏ Hàng</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center flex-wrap mt-2">
            <h2 class="text-coffee fw-bold">Giỏ Hàng Của Bạn</h2>

            <!-- 🔥 NÚT XEM TIẾN TRÌNH ĐƠN HÀNG -->
            <a asp-controller="Account" asp-action="MyOrders"
               class="btn btn-outline-dark rounded-pill px-4">
                <i class="fa-solid fa-truck-fast me-2"></i>
                Theo dõi đơn hàng
            </a>
        </div>
    </div>

@if (Model != null && Model.Count > 0)
{
    <form asp-controller="Cart" asp-action="Checkout" method="post" class="row w-100 m-0 p-0">

        <!-- LEFT -->
        <div class="col-lg-8 mb-4">
            <div class="bg-white rounded-4 shadow-sm overflow-hidden border-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-secondary">
                            <tr>
                                <th class="ps-4" width="50">
                                    <input type="checkbox" id="selectAll" class="form-check-input" checked onchange="toggleAll(this)" />
                                </th>
                                <th>Sản Phẩm</th>
                                <th width="150" class="text-center">Đơn Giá</th>
                                <th width="150" class="text-center">Số Lượng</th>
                                <th width="150" class="text-end pe-4">Thành Tiền</th>
                                <th width="80" class="text-center">Xóa</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <input type="checkbox"
                                               name="selectedProducts"
                                               value="@item.ProductId"
                                               class="form-check-input cart-checkbox"
                                               checked
                                               onchange="updateTotal()" />
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="rounded-3 overflow-hidden" style="width:60px;height:60px;">
                                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)"
                                                     class="w-100 h-100 object-fit-cover" />
                                            </div>
                                            <div class="fw-bold text-coffee">@item.Name</div>
                                        </div>
                                    </td>

                                    <td class="text-center item-price" data-price="@item.Price">
                                        @item.Price.ToString("N0") ₫
                                    </td>

                                    <td class="text-center">
                                        <div class="d-flex justify-content-center align-items-center">

                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty('@item.ProductId', -1)">-</button>

                                            <input type="number"
                                                   id="qty-@item.ProductId"
                                                   name="quantities[@item.ProductId]"
                                                   value="@item.Quantity"
                                                   min="1"
                                                   class="form-control text-center mx-1"
                                                   style="width:60px"
                                                   onchange="updateTotal()" />

                                            <button type="button" class="btn btn-sm btn-light"
                                                    onclick="updateQty('@item.ProductId', 1)">+</button>
                                        </div>
                                    </td>

                                    <td class="text-end fw-bold text-gold pe-4 item-total">
                                        @((item.Price * item.Quantity).ToString("N0")) ₫
                                    </td>

                                    <td class="text-center">
                                        <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.ProductId"
                                           class="btn btn-sm btn-danger rounded-circle">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">
            <div class="cart-summary bg-white p-4 rounded-4 shadow-sm">

                <h5 class="fw-bold text-coffee mb-3">Tóm Tắt</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span>Tạm tính:</span>
                    <span id="subTotal">0 ₫</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span>Vận chuyển:</span>
                    <span class="text-success">Miễn phí</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between mb-3">
                    <strong>Tổng:</strong>
                    <strong id="finalTotal" class="text-gold">0 ₫</strong>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                    Thanh Toán
                </button>

                <a asp-controller="Product" asp-action="Index"
                   class="btn btn-outline-dark w-100 mt-2 rounded-pill">
                    Tiếp tục mua hàng
                </a>

                <!-- 🔥 THÊM TIẾN TRÌNH ĐƠN HÀNG -->
                <a asp-controller="Account" asp-action="MyOrders"
                   class="btn btn-outline-warning w-100 mt-3 rounded-pill">
                    <i class="fa-solid fa-truck-fast me-2"></i>
                    Xem tiến trình đơn hàng
                </a>

            </div>
        </div>

    </form>
}
else
{
    <div class="col-12 text-center">
        <div class="bg-white p-5 rounded-4 shadow-sm">
            <i class="fa-solid fa-cart-shopping fa-3x mb-3 text-muted"></i>
            <h4>Giỏ hàng trống</h4>
            <a asp-controller="Product" asp-action="Index"
               class="btn btn-primary mt-3 rounded-pill">
                Khám phá cà phê
            </a>
        </div>
    </div>
}
</div>

@section Scripts {
<script>
    function updateQty(id, change) {
        const input = document.getElementById(`qty-${id}`);
        let val = parseInt(input.value) + change;
        if (val < 1) val = 1;
        input.value = val;
        updateTotal();
    }

    function toggleAll(source) {
        document.querySelectorAll('.cart-checkbox')
            .forEach(cb => cb.checked = source.checked);
        updateTotal();
    }

    function updateTotal() {
        let total = 0;

        document.querySelectorAll('tbody tr').forEach(row => {

            const cb = row.querySelector('.cart-checkbox');
            const price = parseFloat(row.querySelector('.item-price').dataset.price);
            const qty = parseInt(row.querySelector('input[type="number"]').value);

            const rowTotal = price * qty;
            row.querySelector('.item-total').innerText =
                rowTotal.toLocaleString('vi-VN') + " ₫";

            if (cb.checked) total += rowTotal;
        });

        document.getElementById('subTotal').innerText =
            total.toLocaleString('vi-VN') + " ₫";

        document.getElementById('finalTotal').innerText =
            total.toLocaleString('vi-VN') + " ₫";
    }

    document.addEventListener("DOMContentLoaded", updateTotal);
</script>
}