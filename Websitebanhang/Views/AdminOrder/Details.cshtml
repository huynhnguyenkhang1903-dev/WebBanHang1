@model Websitebanhang.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    var status = Model?.Status ?? "Pending";
}

<div class="container mt-4">

    <!-- 🔔 THÔNG BÁO -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- HEADER -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between">
            <div>
                <h4>Đơn hàng #ORD-@Model.Id.ToString("D3")</h4>
                <p class="mb-0">
                    Ngày đặt:
                    @(Model.OrderDate == default ? "" : Model.OrderDate.ToString("dd/MM/yyyy HH:mm"))
                </p>
            </div>

            <div>
                @switch (status)
                {
                    case "Pending":
                        <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                        break;
                    case "Confirmed":
                        <span class="badge bg-info">Đã duyệt</span>
                        break;
                    case "Preparing":
                        <span class="badge bg-warning text-dark">Đang đóng gói</span>
                        break;
                    case "Shipping":
                        <span class="badge bg-primary">Đang giao</span>
                        break;
                    case "Delivered":
                        <span class="badge bg-success">Đã giao</span>
                        break;
                    case "Cancelled":
                        <span class="badge bg-danger">Đã hủy</span>
                        break;
                }
            </div>
        </div>
    </div>

    <!-- THÔNG TIN -->
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card p-3">
                <strong>Khách hàng:</strong> @Model.CustomerName <br />
                <strong>SĐT:</strong> @Model.Phone <br />
                <strong>Địa chỉ:</strong> @Model.Address
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3 h-100">
                <strong>ĐV Vận chuyển:</strong> @(string.IsNullOrEmpty(Model.ShippingProvider) ? "Mặc định" : Model.ShippingProvider) <br />
                <strong>Thanh toán:</strong> @Model.PaymentMethod <br />
                <strong>Trạng thái:</strong>
                @(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
            </div>
        </div>
    </div>

    <!-- DANH SÁCH SẢN PHẨM -->
    <div class="card mb-4">
        <div class="card-body">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" width="60"
                                         onerror="this.src='/images/default.jpg'" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.Price.ToString("N0") ₫</td>
                                <td>@(item.Price* item.Quantity) ₫</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                Không có sản phẩm
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-end mt-3">
                <div class="text-end" style="width: 300px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tạm tính:</span>
                        <span>@((Model.TotalAmount - Model.ShippingCost).ToString("N0")) ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Phí vận chuyển:</span>
                        <span>@Model.ShippingCost.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2">
                        <span class="fw-bold fs-5">Tổng cộng:</span>
                        <span class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ❌ HIỂN THỊ LÝ DO HỦY -->
    @if (status == "Cancelled" && !string.IsNullOrEmpty(Model.CancelReason))
    {
        <div class="alert alert-danger text-center">
            Lý do hủy: @Model.CancelReason
        </div>
    }

    <!-- ================= ACTION ================= -->

    <div class="text-center">

        @if (User.IsInRole("Admin"))
        {
            <!-- CẬP NHẬT TRẠNG THÁI NHANH -->
            <form asp-action="UpdateStatus" method="post" class="mb-4 p-3 border rounded bg-light text-start mx-auto" style="max-width: 500px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <label class="form-label fw-bold">Cập nhật trạng thái nhanh:</label>
                <div class="input-group">
                    <select name="newStatus" class="form-select">
                        @if(status == "Pending"){ <option value="Pending" selected>Chờ xác nhận</option> } else { <option value="Pending">Chờ xác nhận</option> }
                        @if(status == "Confirmed"){ <option value="Confirmed" selected>Đã duyệt</option> } else { <option value="Confirmed">Đã duyệt</option> }
                        @if(status == "Preparing"){ <option value="Preparing" selected>Đang đóng gói</option> } else { <option value="Preparing">Đang đóng gói</option> }
                        @if(status == "Shipping"){ <option value="Shipping" selected>Đang giao</option> } else { <option value="Shipping">Đang giao</option> }
                        @if(status == "Delivered"){ <option value="Delivered" selected>Đã giao</option> } else { <option value="Delivered">Đã giao</option> }
                        @if(status == "Cancelled"){ <option value="Cancelled" selected>Đã hủy</option> } else { <option value="Cancelled">Đã hủy</option> }
                    </select>
                    <button type="submit" class="btn btn-secondary">Cập nhật</button>
                </div>
            </form>

            <!-- ADMIN ACTION -->
            @if (status == "Pending")
            {
                <form asp-action="Confirm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-success">Duyệt</button>
                </form>
            }

            @if (status == "Confirmed")
            {
                <form asp-action="Preparing" method="post" class="d-inline-block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-warning"><i class="fa-solid fa-box me-1"></i> Đóng gói</button>
                </form>
            }

            @if (status == "Preparing")
            {
                <form asp-action="Shipping" method="post" class="d-inline-block">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-primary"><i class="fa-solid fa-truck me-1"></i> Giao hàng</button>
                </form>
            }

            @if (status == "Shipping")
            {
                <form asp-action="Delivered" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-dark">Hoàn thành</button>
                </form>
            }

            @if (status != "Delivered" && status != "Cancelled")
            {
                <!-- HỦY + LÝ DO -->
                <form asp-action="Cancel" method="post" class="mt-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <textarea name="cancelReason"
                      class="form-control mb-2"
                      placeholder="Nhập lý do hủy..."
                      required></textarea>

                    <button class="btn btn-danger">Hủy đơn</button>
                </form>
            }

            @if (status == OrderStatus.ReturnRequested)
            {
                <div class="card border-warning mb-4 shadow-sm">
                    <div class="card-header bg-warning text-dark fw-bold">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> YÊU CẦU TRẢ HÀNG
                    </div>
                    <div class="card-body">
                        <p><strong>Lý do từ khách hàng:</strong> @Model.ReturnReason</p>
                        <p class="small text-muted">Ngày yêu cầu: @Model.ReturnRequestedAt?.ToString("dd/MM/yyyy HH:mm")</p>
                        
                        <form method="post" class="mt-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-bold">Ghi chú của Admin (Gửi cho khách):</label>
                                <textarea name="adminNote" class="form-control" rows="2" placeholder="Ví dụ: Đồng ý hoàn tiền / Sản phẩm không đủ điều kiện trả hàng..."></textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" asp-action="ApproveReturn" class="btn btn-success flex-fill">
                                    <i class="fa-solid fa-check me-1"></i> Duyệt Trả hàng & Hoàn tiền
                                </button>
                                <button type="submit" asp-action="RejectReturn" class="btn btn-danger flex-fill">
                                    <i class="fa-solid fa-xmark me-1"></i> Từ chối yêu cầu
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @if (status == OrderStatus.Returned || status == OrderStatus.Refunded)
            {
                <div class="alert alert-info">
                    <strong>Trạng thái:</strong> @(status == OrderStatus.Refunded ? "Đã hoàn tiền" : "Đã trả hàng") <br/>
                    <strong>Lý do:</strong> @Model.ReturnReason <br/>
                    @if (!string.IsNullOrEmpty(Model.ReturnAdminNote))
                    {
                        <strong>Ghi chú Admin:</strong> @Model.ReturnAdminNote
                    }
                </div>
            }
        }
        else
        {
            <!-- USER ACTION -->
            @if (!Model.IsPaid && status == "Pending")
            {
                <form asp-controller="Account"
                      asp-action="CancelOrder"
                      method="post"
                      onsubmit="return confirm('Bạn chắc chắn muốn hủy?')">

                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <textarea name="cancelReason"
                      class="form-control mb-2"
                      placeholder="Nhập lý do hủy..."
                      required></textarea>

                    <button class="btn btn-danger">Hủy đơn</button>
                </form>
            }

            @if (status == "Delivered")
            {
                <button class="btn btn-warning"
                        data-bs-toggle="modal"
                        data-bs-target="#returnModal">
                    Trả hàng
                </button>
            }
        }
    </div>

    <!-- BACK & PRINT -->
    <div class="text-center mt-4">
        <a asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-info me-2 text-white">
            <i class="fa-solid fa-print"></i> In hóa đơn
        </a>
        <a asp-action="Index" class="btn btn-outline-dark">Quay lại</a>
    </div>
</div>

<!-- MODAL TRẢ HÀNG -->
<div class="modal fade" id="returnModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Account" asp-action="RequestReturn" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="modal-header">
                    <h5>Trả hàng</h5>
                </div>

                <div class="modal-body">
                    <textarea name="returnReason"
                              class="form-control"
                              placeholder="Lý do trả hàng"
                              required></textarea>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button class="btn btn-warning">Gửi</button>
                </div>
            </form>
        </div>
    </div>
</div>