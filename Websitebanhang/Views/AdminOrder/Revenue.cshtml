@model Websitebanhang.Models.ViewModels.RevenueViewModel
@{
    ViewData["Title"] = "Thống kê doanh thu";
}

<div class="container mt-4">
    <h2 class="mb-4">Thống kê doanh thu</h2>

    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <input type="date" name="from" class="form-control" value="@ViewBag.From" />
        </div>
        <div class="col-auto">
            <input type="date" name="to" class="form-control" value="@ViewBag.To" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">Lọc</button>
        </div>
    </form>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Tổng doanh thu</h5>
                <h3 class="text-danger">@Model.TotalRevenue.ToString("N0") đ</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Tổng đơn</h5>
                <h3>@Model.OrdersCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Đơn hoàn thành</h5>
                <h3>@Model.PaidOrdersCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Sản phẩm bán ra</h5>
                <h3>@Model.TotalProductsSold</h3>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo ngày</h5>
            <table class="table">
                <thead>
                    <tr><th>Ngày</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.RevenueByDay)
                    {
                        <tr>
                            <td>@d.Date.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@d.OrderCount</td>
                            <td class="text-center">@d.ProductsSold</td>
                            <td>@d.Amount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo tháng</h5>
            <table class="table">
                <thead>
                    <tr><th>Tháng</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.RevenueByMonth)
                    {
                        <tr>
                            <td>@m.Month.ToString("D2")/@m.Year</td>
                            <td class="text-center">@m.OrderCount</td>
                            <td class="text-center">@m.ProductsSold</td>
                            <td>@m.Amount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo năm</h5>
            <table class="table">
                <thead>
                    <tr><th>Năm</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var y in Model.RevenueByYear)
                    {
                        <tr>
                            <td>@y.Year</td>
                            <td class="text-center">@y.OrderCount</td>
                            <td class="text-center">@y.ProductsSold</td>
                            <td>@y.Amount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Top Sản Phẩm Bán Chạy</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Đã bán</th>
                        <th>Doanh thu (ước tính)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopProducts != null && Model.TopProducts.Any())
                    {
                        foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td>@p.TotalQuantity</td>
                                <td class="text-danger fw-bold">@p.TotalRevenue.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Chưa có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
