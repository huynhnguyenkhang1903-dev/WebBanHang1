@model Websitebanhang.Models.ViewModels.RevenueViewModel
@{
    ViewData["Title"] = "Thống kê doanh thu";
}

<div class="container mt-4">
    <h2 class="mb-4">Thống kê doanh thu</h2>

    <form method="get" class="row g-2 mb-4">
        <div class="col-auto">
            <input type="date" name="from" class="form-control" value="@ViewBag.From" />
        </div>
        <div class="col-auto">
            <input type="date" name="to" class="form-control" value="@ViewBag.To" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary">Lọc</button>
        </div>
    </form>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Tổng doanh thu</h5>
                <h3 class="text-danger">@Model.TotalRevenue.ToString("N0") đ</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Tổng đơn</h5>
                <h3>@Model.OrdersCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Đơn hoàn thành</h5>
                <h3>@Model.PaidOrdersCount</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3">
                <h5>Sản phẩm bán ra</h5>
                <h3>@Model.TotalProductsSold</h3>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo ngày</h5>
            <table class="table">
                <thead>
                    <tr><th>Ngày</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.RevenueByDay)
                    {
                        <tr>
                            <td>@d.Date.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">@d.OrderCount</td>
                            <td class="text-center">@d.ProductsSold</td>
                            <td>
                                @d.Amount.ToString("N0") đ
                                <button type="button" class="btn btn-sm btn-link py-0 px-1 text-info align-baseline" onclick="fillTaxRevenue(@d.Amount)" title="Tính thuế cho ngày này">
                                    <i class="fa-solid fa-calculator"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo tháng</h5>
            <table class="table">
                <thead>
                    <tr><th>Tháng</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.RevenueByMonth)
                    {
                        <tr>
                            <td>@m.Month.ToString("D2")/@m.Year</td>
                            <td class="text-center">@m.OrderCount</td>
                            <td class="text-center">@m.ProductsSold</td>
                            <td>
                                @m.Amount.ToString("N0") đ
                                <button type="button" class="btn btn-sm btn-link py-0 px-1 text-info align-baseline" onclick="fillTaxRevenue(@m.Amount)" title="Tính thuế cho tháng này">
                                    <i class="fa-solid fa-calculator"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Doanh thu theo năm</h5>
            <table class="table">
                <thead>
                    <tr><th>Năm</th><th class="text-center">Số đơn</th><th class="text-center">Sản phẩm bán ra</th><th>Doanh thu</th></tr>
                </thead>
                <tbody>
                    @foreach (var y in Model.RevenueByYear)
                    {
                        <tr>
                            <td>@y.Year</td>
                            <td class="text-center">@y.OrderCount</td>
                            <td class="text-center">@y.ProductsSold</td>
                            <td>
                                @y.Amount.ToString("N0") đ
                                <button type="button" class="btn btn-sm btn-link py-0 px-1 text-info align-baseline" onclick="fillTaxRevenue(@y.Amount)" title="Tính thuế cho năm này">
                                    <i class="fa-solid fa-calculator"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5>Top Sản Phẩm Bán Chạy</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tên sản phẩm</th>
                        <th>Đã bán</th>
                        <th>Doanh thu (ước tính)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TopProducts != null && Model.TopProducts.Any())
                    {
                        foreach (var p in Model.TopProducts)
                        {
                            <tr>
                                <td>@p.ProductName</td>
                                <td>@p.TotalQuantity</td>
                                <td class="text-danger fw-bold">@p.TotalRevenue.ToString("N0") đ</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">Chưa có dữ liệu</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- CÔNG CỤ TÍNH THUẾ DOANH THU -->
    <div class="card shadow-sm border-0 mb-4 rounded-4 overflow-hidden">
        <div class="card-header bg-dark text-white fw-bold py-3">
            <i class="fa-solid fa-calculator text-warning me-2"></i> CÔNG CỤ TÍNH THUẾ DOANH THU (DÀNH CHO ADMIN)
        </div>
        <div class="card-body p-4 bg-light">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small text-uppercase">Doanh thu tính thuế (đ)</label>
                    <div class="input-group">
                        <input type="number" id="taxRevenueInput" class="form-control form-control-lg rounded-3" value="@Model.TotalRevenue" placeholder="Nhập doanh thu..." />
                        <button class="btn btn-outline-secondary" type="button" onclick="resetTaxRevenue()" title="Đặt lại về tổng doanh thu">
                            <i class="fa-solid fa-arrows-rotate"></i>
                        </button>
                    </div>
                    <div class="form-text text-muted small">Lấy từ doanh thu đang lọc hoặc click nút calculator trong bảng để điền.</div>
                </div>
                
                <div class="col-md-4">
                    <label class="form-label fw-bold text-muted small text-uppercase">Thuế suất (%)</label>
                    <div class="input-group">
                        <input type="number" id="taxRateInput" class="form-control form-control-lg rounded-3" value="10" min="0" max="100" step="0.1" placeholder="Nhập phần trăm..." />
                        <span class="input-group-text">%</span>
                    </div>
                    <div class="form-text text-muted small">Nhập tỷ lệ phần trăm thuế áp dụng (Ví dụ: 10, 8, 5...).</div>
                </div>

                <div class="col-md-4 d-flex align-items-end">
                    <button type="button" class="btn btn-warning w-100 py-3 rounded-3 fw-bold text-uppercase shadow-sm" onclick="calculateRevenueTax()">
                        <i class="fa-solid fa-calculator me-2"></i> Tính toán thuế
                    </button>
                </div>
            </div>

            <!-- Kết quả tính toán -->
            <div id="taxResultBox" class="mt-4 p-4 rounded-3 bg-white border d-none">
                <h6 class="fw-bold mb-3 text-dark border-bottom pb-2">
                    <i class="fa-solid fa-square-poll-vertical text-info me-2"></i>KẾT QUẢ TÍNH THUẾ
                </h6>
                <div class="row g-3">
                    <div class="col-md-6 border-end">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Doanh thu trước thuế:</span>
                            <span class="fw-bold text-dark" id="resBaseRevenue">0 đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Thuế suất áp dụng:</span>
                            <span class="fw-bold text-dark" id="resTaxRate">0%</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-danger">Tiền thuế phải nộp:</span>
                            <span class="fw-bold text-danger fs-5" id="resTaxAmount">0 đ</span>
                        </div>
                    </div>
                    <div class="col-md-6 ps-md-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Doanh thu thực nhận (Sau thuế):</span>
                            <span class="fw-bold text-success fs-5" id="resNetProfit">0 đ</span>
                        </div>
                        <div class="small text-muted mt-3">
                            <i class="fa-solid fa-circle-info me-1"></i> <strong>Công thức tính:</strong>
                            <br />- Tiền thuế = Doanh thu &times; (Thuế suất / 100)
                            <br />- Thực nhận = Doanh thu &minus; Tiền thuế
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function formatVND(amount) {
        return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(amount).replace('₫', 'đ');
    }

    function calculateRevenueTax() {
        const revenue = parseFloat(document.getElementById('taxRevenueInput').value) || 0;
        const taxRate = parseFloat(document.getElementById('taxRateInput').value) || 0;

        if (revenue < 0 || taxRate < 0 || taxRate > 100) {
            alert('Vui lòng nhập doanh thu và thuế suất hợp lệ (0-100%).');
            return;
        }

        const taxAmount = revenue * (taxRate / 100);
        const netProfit = revenue - taxAmount;

        document.getElementById('resBaseRevenue').innerText = formatVND(revenue);
        document.getElementById('resTaxRate').innerText = taxRate + '%';
        document.getElementById('resTaxAmount').innerText = formatVND(taxAmount);
        document.getElementById('resNetProfit').innerText = formatVND(netProfit);

        document.getElementById('taxResultBox').classList.remove('d-none');
    }

    function resetTaxRevenue() {
        document.getElementById('taxRevenueInput').value = "@Model.TotalRevenue";
        document.getElementById('taxResultBox').classList.add('d-none');
    }

    function fillTaxRevenue(amount) {
        document.getElementById('taxRevenueInput').value = amount;
        calculateRevenueTax();
        
        // Scroll to calculator smoothly
        document.getElementById('taxRevenueInput').scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
</script>
