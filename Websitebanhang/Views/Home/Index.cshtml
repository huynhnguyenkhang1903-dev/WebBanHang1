@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<div class="hero text-white d-flex align-items-center justify-content-center">
    <div class="text-center">
        <h1 class="display-4 fw-bold mb-3">☕ Coffee Shop</h1>
        <p class="lead mb-4">Thưởng thức cà phê nguyên chất mỗi ngày</p>

        <a asp-controller="Product"
           asp-action="Index"
           class="btn btn-warning btn-lg px-4">
            Khám phá ngay
        </a>
    </div>
</div>

<!-- FEATURE SECTION -->
<div class="container mt-5">

    <div class="row text-center">

        <div class="col-md-4 mb-4">
            <div class="card shadow p-4 h-100">
                <i class="fa fa-coffee fa-3x mb-3 text-dark"></i>
                <h5>Cà phê chất lượng</h5>
                <p>Hạt cà phê tuyển chọn từ nhiều quốc gia</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow p-4 h-100">
                <i class="fa fa-truck fa-3x mb-3 text-dark"></i>
                <h5>Giao hàng nhanh</h5>
                <p>Giao tận nơi trong 24h</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow p-4 h-100">
                <i class="fa fa-star fa-3x mb-3 text-dark"></i>
                <h5>Hương vị tuyệt vời</h5>
                <p>Đậm đà – thơm ngon – chuẩn gu</p>
            </div>
        </div>

    </div>

</div>

<!-- PRODUCT PREVIEW -->
<div class="container mt-5">

    <h3 class="text-center mb-4 fw-bold">Sản phẩm nổi bật</h3>

    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="/images/coffee1.jpg" class="card-img-top" />
                <div class="card-body text-center">
                    <h5>Arabica</h5>
                    <p class="text-muted">Hương nhẹ, thanh</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="/images/coffee2.jpg" class="card-img-top" />
                <div class="card-body text-center">
                    <h5>Robusta</h5>
                    <p class="text-muted">Đậm đà, mạnh mẽ</p>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow">
                <img src="/images/coffee3.jpg" class="card-img-top" />
                <div class="card-body text-center">
                    <h5>Espresso</h5>
                    <p class="text-muted">Tinh tế, đậm vị</p>
                </div>
            </div>
        </div>

    </div>

</div>