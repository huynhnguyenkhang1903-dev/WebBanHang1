@model Websitebanhang.Models.SupportRequest
@inject Websitebanhang.Services.IWebsiteSettingService SettingService
@{
    ViewData["Title"] = "Liên Hệ Aura Coffee";
    var hotline = await SettingService.GetSettingAsync("Hotline", "0344.506.553");
    var email = await SettingService.GetSettingAsync("Email", "support@auracoffee.com");
    var address = await SettingService.GetSettingAsync("Address", "123 Đường Cà Phê, TP. Hồ Chí Minh");
    var facebook = await SettingService.GetSettingAsync("Facebook", "#");
}

<div class="container mt-5 mb-5 fade-in">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-3 shadow-sm border-0 bg-success text-white" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row text-center mb-5">
        <div class="col-12">
            <h1 class="display-4 fw-bold text-coffee mb-3">Liên Hệ Với Chúng Tôi</h1>
            <p class="lead text-secondary mx-auto" style="max-width: 600px;">
                Cảm ơn bạn đã quan tâm đến Aura Coffee. Hãy để lại thông tin hoặc liên hệ trực tiếp với chúng tôi qua các kênh dưới đây để được hỗ trợ nhanh nhất.
            </p>
        </div>
    </div>

    <div class="row g-5">
        <!-- Thông tin liên hệ -->
        <div class="col-md-5">
            <div class="bg-light p-5 rounded-4 shadow-sm h-100">
                <h3 class="mb-4 text-coffee">Thông Tin Cửa Hàng</h3>
                
                <div class="d-flex align-items-center mb-4">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fa-solid fa-location-dot text-gold fs-5"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-1 fw-bold">Địa Chỉ</h6>
                        <p class="text-muted mb-0">@address</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fa-solid fa-phone text-gold fs-5"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-1 fw-bold">Hotline</h6>
                        <p class="text-muted mb-0">@hotline</p>
                    </div>
                </div>

                <div class="d-flex align-items-center mb-4">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fa-solid fa-envelope text-gold fs-5"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-1 fw-bold">Email</h6>
                        <p class="text-muted mb-0">@email</p>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="bg-white rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 50px; height: 50px; min-width: 50px;">
                        <i class="fa-regular fa-clock text-gold fs-5"></i>
                    </div>
                    <div class="ms-3">
                        <h6 class="mb-1 fw-bold">Giờ Mở Cửa</h6>
                        <p class="text-muted mb-0">Thứ 2 - Chủ Nhật: 7:00 Sáng - 10:00 Tối</p>
                    </div>
                </div>
                
                <hr class="my-4">
                
                <h6 class="fw-bold text-coffee mb-3">Kết nối Mạng Xã Hội</h6>
                <div class="d-flex gap-3 fs-4">
                    <a href="@facebook" target="_blank" class="text-coffee"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#" class="text-coffee"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="text-coffee"><i class="fa-brands fa-tiktok"></i></a>
                </div>
            </div>
        </div>

        <!-- Form gửi tin nhắn -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-5">
                    <h3 class="mb-4 text-coffee">Gửi Yêu Cầu Hỗ Trợ</h3>
                    <form asp-action="Contact" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold">Họ và Tên</label>
                                <input asp-for="Name" class="form-control" placeholder="Nhập tên của bạn" value="@ViewBag.DefaultName">
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold">Số Điện Thoại</label>
                                <input asp-for="Phone" class="form-control" placeholder="Nhập số điện thoại" value="@ViewBag.DefaultPhone">
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Email" class="form-label fw-bold">Email</label>
                                <input asp-for="Email" class="form-control" placeholder="Nhập địa chỉ email" value="@ViewBag.DefaultEmail">
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Subject" class="form-label fw-bold">Chủ Đề</label>
                                <input asp-for="Subject" class="form-control" placeholder="Nhập chủ đề cần hỗ trợ">
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Message" class="form-label fw-bold">Nội Dung</label>
                                <textarea asp-for="Message" class="form-control" rows="5" placeholder="Bạn cần chúng tôi giúp đỡ điều gì?"></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>
                            <div class="col-12 mt-4">
                                <button type="submit" class="btn btn-primary-custom px-5 py-2 w-100 fw-bold">Gửi Yêu Cầu Hỗ Trợ <i class="fa-solid fa-paper-plane ms-2"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bản đồ -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4 text-coffee">Bản Đồ Cửa Hàng</h3>
            <div class="rounded-4 overflow-hidden shadow-sm position-relative" style="height: 400px; background-color: #f8f9fa;">
                <iframe 
                    src="https://maps.google.com/maps?q=Cafe+Milano+Đỗ+Quyên&t=&z=17&ie=UTF8&iwloc=&output=embed" 
                    width="100%" 
                    height="100%" 
                    style="border:0;" 
                    allowfullscreen="" 
                    loading="lazy" 
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
            <div class="mt-3 text-end">
                <a href="https://maps.app.goo.gl/Rc42HCXHnun7EVTB7" target="_blank" class="btn btn-outline-primary shadow-sm">
                    <i class="fa-solid fa-map-location-dot me-2"></i>Mở trong Google Maps
                </a>
            </div>
        </div>
    </div>
</div>
