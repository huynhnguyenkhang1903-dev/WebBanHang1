@model List<CartItem>

<div class="container mt-4">

    <h2 class="text-center mb-4">🧾 Thanh toán</h2>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-warning text-center">
            Giỏ hàng của bạn đang trống
        </div>

        <div class="text-center">
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                Tiếp tục mua sắm
            </a>
        </div>
    }
    else
    {

        <table class="table table-bordered text-center align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Sản phẩm</th>
                    <th width="120">Giá</th>
                    <th width="120">Số lượng</th>
                    <th width="150">Tổng cộng</th>
                </tr>
            </thead>

            <tbody>

                @{
                    decimal grandTotal = 0;
                }

                @foreach (var item in Model)
                {
                    if (item != null)
                    {
                        var total = item.Price * item.Quantity;
                        grandTotal += total;

                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Price.ToString("N0") ₫</td>
                            <td>@item.Quantity</td>
                            <td class="text-danger fw-bold">@total.ToString("N0") ₫</td>
                        </tr>
                    }
                }

                <tr class="table-warning fw-bold">
                    <td colspan="3">Tổng tiền</td>
                    <td class="text-danger">@grandTotal.ToString("N0") ₫</td>
                </tr>

            </tbody>

        </table>

        <hr />

        <h4 class="mb-3 mt-4">Thông tin khách hàng</h4>

        <form asp-action="PlaceOrder" method="post" class="card shadow-sm p-4 border-0">

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Họ và tên</label>
                    <input name="name" class="form-control" required placeholder="Nhập họ tên của bạn..." />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Số điện thoại</label>
                    <input name="phone" type="tel" class="form-control" required placeholder="Nhập số điện thoại..." />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Email</label>
                <input name="email" type="email" class="form-control" required placeholder="Nhập địa chỉ email..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Địa chỉ giao hàng</label>
                <input name="address" class="form-control" required placeholder="Nhập địa chỉ chi tiết..." />
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Phương thức thanh toán</label>
                <select name="paymentMethod" class="form-select" required>
                    <option value="" disabled selected>Chọn phương thức thanh toán...</option>
                    <option value="cod">Thanh toán khi nhận hàng (COD)</option>
                    <option value="transfer">Chuyển khoản ngân hàng</option>
                </select>
            </div>

            <div class="text-end mt-2">
                <a asp-controller="Cart" asp-action="Index"
                   class="btn btn-outline-secondary me-2">
                    <i class="fa fa-arrow-left"></i> Quay lại giỏ hàng
                </a>

                <button type="submit" class="btn btn-success px-4">
                    <i class="fa fa-check-circle"></i> Đặt Hàng
                </button>
            </div>

        </form>

    }

</div>