@{
    ViewData["Title"] = "Thanh toán chuyển khoản";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center bg-white p-4 rounded shadow-sm">
            <h3 class="mb-3">Thanh toán bằng chuyển khoản</h3>

            <p class="mb-1"><strong>Số tiền:</strong> @ViewBag.Amount.ToString("N0") ₫</p>
            <p class="mb-3"><strong>Nội dung chuyển khoản:</strong> <code class="text-danger fw-bold fs-5">@ViewBag.Content</code></p>

            <div class="mb-4 d-flex justify-content-center">
                <img src="@ViewBag.QRCode" alt="QR Thanh toán" class="img-fluid border p-2" style="max-width: 320px;" />
            </div>

            <div class="d-flex justify-content-center mb-4">
                <img src="~/images/napas247.png" height="24" class="me-2" alt="Napas 247" onerror="this.style.display='none'" />
                <img src="~/images/mb.png" height="24" alt="MB Bank" onerror="this.style.display='none'" />
            </div>

            <div class="row mb-4">
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="card p-3 h-100">
                        <div class="small text-muted mb-1">Ngân hàng</div>
                        <div class="fw-bold fs-5">@ViewBag.BankCode</div>
                    </div>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <div class="card p-3 h-100">
                        <div class="small text-muted mb-1">Số tài khoản</div>
                        <div class="fw-bold fs-5">@ViewBag.AccountNumber</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 w-100" onclick="copyText('@ViewBag.AccountNumber')">Sao chép</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card p-3 h-100">
                        <div class="small text-muted mb-1">Chủ tài khoản</div>
                        <div class="fw-bold fs-6">@ViewBag.AccountName</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2 w-100" onclick="copyText('@ViewBag.AccountName')">Sao chép</button>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <form asp-controller="Cart" asp-action="CheckPayment" method="get">
                    <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
                    <button type="submit" class="btn btn-success btn-lg px-4">Tôi đã chuyển khoản</button>
                </form>

                <form asp-controller="Home" asp-action="Index" method="get">
                    <button type="submit" class="btn btn-outline-secondary btn-lg px-4">Quay lại cửa hàng</button>
                </form>
            </div>

            <p class="small text-danger mt-4 fst-italic">Lưu ý: Vui lòng nhập chính xác <strong>nội dung chuyển khoản</strong> để hệ thống đối soát đơn hàng tự động.</p>
        </div>
    </div>
</div>

<script>
    function copyText(text) {
        if (!text) return;
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function() {
                alert('Đã sao chép: ' + text);
            });
        } else {
            var temp = document.createElement('textarea');
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            alert('Đã sao chép: ' + text);
        }
    }
</script>
