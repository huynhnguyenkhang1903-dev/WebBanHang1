@model Websitebanhang.Models.Product

@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as List<Websitebanhang.Models.Product> ?? new List<Websitebanhang.Models.Product>();
}

@section Styles {
    <style>
        .rating-stars {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
        }
        .rating-stars input {
            display: none;
        }
        .rating-stars label {
            cursor: pointer;
            font-size: 1.5rem;
            color: #ddd;
            margin-right: 5px;
            transition: color 0.2s;
        }
        .rating-stars input:checked ~ label,
        .rating-stars label:hover,
        .rating-stars label:hover ~ label {
            color: #ffc107;
        }
    </style>
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item"><a href="/Product" class="text-secondary">Cà Phê</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>

    <!-- Product Display -->
    <div class="col-12 mb-5">
        <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm">
            <div class="row g-5 align-items-center">
                <!-- Left: Image -->
                <div class="col-md-6">
                    <div class="product-img-wrapper rounded-4 overflow-hidden shadow-sm position-relative">
                        @if (!string.IsNullOrEmpty(Model.Country))
                        {
                            <span class="badge bg-dark position-absolute top-0 start-0 m-3 z-index-2 px-3 py-2 fs-6 rounded-pill" style="z-index: 10;">
                                <i class="fa-solid fa-earth-americas me-2 text-gold"></i>@Model.Country
                            </span>
                        }

                        @{
                            var allImages = new List<string>();
                            allImages.Add(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl);
                            if (Model.Images != null && Model.Images.Any())
                            {
                                allImages.AddRange(Model.Images.OrderBy(i => i.OrderIndex).Select(i => i.ImageUrl));
                            }
                        }

                        @if (allImages.Count > 1)
                        {
                            <div id="productCarousel" class="carousel slide h-100" data-bs-ride="carousel">
                                <div class="carousel-inner h-100">
                                    @for (int i = 0; i < allImages.Count; i++)
                                    {
                                        <div class="carousel-item h-100 @(i == 0 ? "active" : "")">
                                            <img src="@allImages[i]" class="d-block w-100 h-100 object-fit-cover transition-transform" alt="@Model.Name">
                                        </div>
                                    }
                                </div>
                                <button class="carousel-control-prev" type="button" data-bs-target="#productCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon bg-dark rounded-circle p-3 bg-opacity-50" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#productCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon bg-dark rounded-circle p-3 bg-opacity-50" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <img src="@allImages[0]" alt="@Model.Name" class="w-100 h-100 object-fit-cover transition-transform" />
                        }
                    </div>
                </div>

                <!-- Right: Information -->
                <div class="col-md-6">
                    <h1 class="display-5 text-coffee fw-bold mb-2">@Model.Name</h1>
                    @{
                        var approvedReviews = Model.Reviews?.Where(r => r.IsApproved && !r.IsHidden).ToList() ?? new List<Websitebanhang.Models.Review>();
                        var totalReviews = approvedReviews.Count;
                        double avgRating = totalReviews > 0 ? approvedReviews.Average(r => r.Rating) : 0;
                        int roundedRating = (int)Math.Round(avgRating);
                    }
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="text-warning">
                            @for(int i=1; i<=5; i++) {
                                if (i <= roundedRating) { <i class="fa-solid fa-star"></i> }
                                else { <i class="fa-regular fa-star"></i> }
                            }
                        </div>
                        <span class="text-muted small border-start ps-3">(@totalReviews đánh giá đã duyệt)</span>
                    </div>

                    <div class="display-4 text-gold fw-bold mb-4">@Model.Price.ToString("N0") <span class="fs-4 text-secondary">₫</span></div>
                    
                    <p class="text-secondary fs-5 mb-5 lh-lg">
                        @(string.IsNullOrEmpty(Model.Description) ? "Dòng cà phê nguyên bản mang hương vị đậm đà, được chọn lọc kỹ càng từ những vùng trồng cà phê tốt nhất." : Model.Description)
                    </p>
                    
                    <div class="d-flex flex-column gap-2 mb-4">
                        <div class="d-flex gap-3 align-items-center">
                            <span class="fw-medium text-dark" style="width: 120px;"><i class="fa-solid fa-check text-success me-2"></i>Tình trạng:</span>
                            @if (Model.Stock > 0)
                            {
                                <span class="badge bg-success py-2 px-3">Còn hàng (@Model.Stock sẵn có)</span>
                            }
                            else
                            {
                                <span class="badge bg-danger py-2 px-3">Hết hàng</span>
                            }
                        </div>

                        @if (Model.ExpiryDate.HasValue)
                        {
                            var isExpired = Model.ExpiryDate.Value <= DateTime.Now;
                            var isNearExpiry = !isExpired && Model.ExpiryDate.Value <= DateTime.Now.AddDays(15);
                            <div class="d-flex gap-3 align-items-center">
                                <span class="fw-medium text-dark" style="width: 120px;"><i class="fa-solid fa-clock text-info me-2"></i>Hạn sử dụng:</span>
                                <span class="text-secondary">@Model.ExpiryDate.Value.ToString("dd/MM/yyyy")</span>
                                @if (isExpired)
                                {
                                    <span class="badge bg-danger ms-2"><i class="fa-solid fa-triangle-exclamation me-1"></i>Đã hết hạn</span>
                                }
                                else if (isNearExpiry)
                                {
                                    <span class="badge bg-warning text-dark ms-2"><i class="fa-solid fa-circle-exclamation me-1"></i>Sắp hết hạn</span>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.Stock > 0)
                    {
                        var isExpired = Model.ExpiryDate.HasValue && Model.ExpiryDate.Value <= DateTime.Now;
                        @if (isExpired)
                        {
                            <div class="mt-4 border-top pt-4">
                                <div class="alert alert-danger shadow-sm border-0">
                                    <i class="fa-solid fa-ban me-2"></i> Sản phẩm đã hết hạn sử dụng. Vui lòng chọn sản phẩm khác.
                                </div>
                                <button class="btn btn-secondary btn-lg w-100 shadow-sm fs-5" disabled>
                                    Không thể mua sản phẩm này
                                </button>
                            </div>
                        }
                        else
                        {
                            <form action="/Cart/AddToCart" method="post" class="mt-4 border-top pt-4">
                                <input type="hidden" name="id" value="@Model.Id" />
                                
                                <div class="d-flex flex-column flex-sm-row gap-3">
                                    <!-- Optional Quantity Selector for Display page -->
                                    <div class="input-group" style="width: 150px;">
                                        <button class="btn btn-outline-secondary px-3" type="button" onclick="const q=document.getElementById('displayQty'); if(q.value>1)q.value--">-</button>
                                        <input id="displayQty" type="text" name="quantity" class="form-control text-center fw-bold" value="1" readonly>
                                        <button class="btn btn-outline-secondary px-3" type="button" onclick="const q=document.getElementById('displayQty'); if(q.value < @Model.Stock) q.value++">+</button>
                                    </div>

                                    <button type="submit" class="btn btn-primary-custom btn-lg flex-grow-1 shadow-sm fs-5">
                                        <i class="fa-solid fa-cart-arrow-down me-2"></i> Thêm Vào Giỏ Hàng
                                    </button>
                                    
                                    <a asp-controller="Wishlist" asp-action="Add" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-danger btn-lg shadow-sm px-4" title="Thêm vào yêu thích">
                                        <i class="fa-regular fa-heart"></i>
                                    </a>
                                    
                                    <a asp-controller="Compare" asp-action="Add" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path" class="btn btn-outline-info btn-lg shadow-sm px-4" title="Thêm vào so sánh">
                                        <i class="fa-solid fa-code-compare"></i>
                                    </a>
                                </div>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="mt-4 border-top pt-4">
                            <button class="btn btn-secondary btn-lg w-100 shadow-sm fs-5" disabled>
                                <i class="fa-solid fa-phone me-2"></i> Liên Hệ Nhập Hàng
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

        </div>
    </div>

    <!-- Reviews Section -->
    <div class="col-12 mb-5 fade-in delay-1">
        <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm">
            <h3 class="text-coffee fw-bold border-bottom pb-3 mb-4">Đánh Giá Sản Phẩm</h3>
            
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row">
                <!-- Review Form -->
                <div class="col-md-5 mb-5 mb-md-0">
                    <h5 class="fw-bold mb-3">Gửi đánh giá của bạn</h5>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Product" asp-action="AddReview" method="post" class="p-4 bg-light rounded-4">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-medium">Đánh giá sao</label>
                                <div class="rating-stars mb-2">
                                    <input type="radio" name="rating" id="r5" value="5" required checked /><label for="r5" class="fa-solid fa-star"></label>
                                    <input type="radio" name="rating" id="r4" value="4" /><label for="r4" class="fa-solid fa-star"></label>
                                    <input type="radio" name="rating" id="r3" value="3" /><label for="r3" class="fa-solid fa-star"></label>
                                    <input type="radio" name="rating" id="r2" value="2" /><label for="r2" class="fa-solid fa-star"></label>
                                    <input type="radio" name="rating" id="r1" value="1" /><label for="r1" class="fa-solid fa-star"></label>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-medium">Bình luận của bạn</label>
                                <textarea name="comment" class="form-control" rows="4" placeholder="Nhận xét về chất lượng, hương vị..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary-custom px-4 rounded-pill">Gửi Đánh Giá</button>
                        </form>
                    }
                    else
                    {
                        <div class="p-4 bg-light rounded-4 text-center">
                            <i class="fa-regular fa-comment-dots fs-1 text-muted mb-3"></i>
                            <p class="mb-3">Vui lòng đăng nhập để có thể đánh giá và bình luận sản phẩm.</p>
                            <a href="/Account/Login" class="btn btn-outline-dark rounded-pill px-4">Đăng Nhập</a>
                        </div>
                    }
                </div>

                <!-- Comments List -->
                <div class="col-md-7 ps-md-5">
                    <h5 class="fw-bold mb-4">Tất cả bình luận (@totalReviews)</h5>
                    
                    @if (approvedReviews.Any())
                    {
                        <div class="review-list" style="max-height: 500px; overflow-y: auto;">
                            @foreach (var review in approvedReviews.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="d-flex mb-4 pb-4 border-bottom">
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrEmpty(review.User?.AvatarUrl))
                                        {
                                            <img src="@review.User.AvatarUrl" class="rounded-circle" style="width: 50px; height: 50px; object-fit: cover;" alt="Avatar" />
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.2rem;">
                                                @(review.User?.FullName?.FirstOrDefault() ?? 'U')
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <h6 class="fw-bold mb-0">@(review.User?.FullName ?? review.User?.UserName ?? "Khách hàng")</h6>
                                            <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                        </div>
                                        <div class="text-warning small mb-2">
                                            @for(int i=1; i<=5; i++) {
                                                if (i <= review.Rating) { <i class="fa-solid fa-star"></i> }
                                                else { <i class="fa-regular fa-star"></i> }
                                            }
                                        </div>
                                        <p class="mb-2 text-secondary">@review.Comment</p>
                                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <button class="btn btn-link btn-sm text-muted p-0 small"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#reportModal-@review.Id"
                                                    title="Báo cáo bình luận này">
                                                <i class="fa-solid fa-flag me-1 text-danger"></i>Báo cáo
                                            </button>

                                            <!-- Report Modal -->
                                            <div class="modal fade" id="reportModal-@review.Id" tabindex="-1">
                                                <div class="modal-dialog modal-sm">
                                                    <div class="modal-content">
                                                        <div class="modal-header py-2">
                                                            <h6 class="modal-title"><i class="fa-solid fa-flag text-danger me-2"></i>Báo cáo bình luận</h6>
                                                            <button type="button" class="btn-close btn-sm" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <form asp-controller="Product" asp-action="ReportReview" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="reviewId" value="@review.Id" />
                                                            <input type="hidden" name="productId" value="@Model.Id" />
                                                            <div class="modal-body">
                                                                <label class="form-label small fw-medium">Lý do báo cáo</label>
                                                                <select name="reason" class="form-select form-select-sm" required>
                                                                    <option value="">-- Chọn lý do --</option>
                                                                    <option value="Nội dung tục tử">Nội dung tục tử</option>
                                                                    <option value="Spam / Quảng cáo">Spam / Quảng cáo</option>
                                                                    <option value="Thông tin sai sự thật">Thông tin sai sự thật</option>
                                                                    <option value="Ngôn ngữ thù hằn / khích lệ bạo lực">Ngôn ngữ thù hằn</option>
                                                                    <option value="Lý do khác">Lý do khác</option>
                                                                </select>
                                                            </div>
                                                            <div class="modal-footer py-2">
                                                                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                                <button type="submit" class="btn btn-danger btn-sm">
                                                                    <i class="fa-solid fa-flag me-1"></i>Gửi báo cáo
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fa-solid fa-comments fs-2 mb-3"></i>
                            <p>Chưa có đánh giá nào. Hãy trở thành người đầu tiên!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (relatedProducts.Any())
    {
        <div class="col-12 mt-5 pt-4 fade-in delay-3">
            <div class="d-flex align-items-center gap-3 mb-4">
                <h3 class="text-coffee fw-bold mb-0">Sản Phẩm Cùng Loại</h3>
                <div class="flex-grow-1 border-bottom" style="height: 1px; opacity: 0.2;"></div>
            </div>
            
            <div class="row g-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-hover transition-all" style="border-radius: 15px; overflow: hidden; background: #fff;">
                            <div class="position-relative overflow-hidden group" style="aspect-ratio: 1/1;">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)" 
                                     class="card-img-top w-100 h-100 object-fit-cover transition-transform" 
                                     alt="@item.Name" 
                                     style="transition: transform 0.5s ease;">
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center opacity-0 group-hover-opacity-100 transition-all" style="background: rgba(0,0,0,0.2); backdrop-filter: blur(2px);">
                                    <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-pill fw-bold px-3 shadow-sm">Chi tiết</a>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <h6 class="card-title text-truncate fw-bold mb-1">
                                    <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="text-decoration-none text-dark">@item.Name</a>
                                </h6>
                                <div class="d-flex justify-content-between align-items-center mt-2">
                                    <span class="text-gold fw-bold">@item.Price.ToString("N0") ₫</span>
                                    @if(item.Stock > 0) {
                                        <form action="/Cart/AddToCart" method="post" class="m-0">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-outline-coffee btn-sm rounded-circle" style="width: 32px; height: 32px; padding: 0;">
                                                <i class="fa-solid fa-cart-plus"></i>
                                            </button>
                                        </form>
                                    } else {
                                        <span class="badge bg-secondary-subtle text-secondary small">Hết hàng</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>