@model Websitebanhang.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-5">
    <div class="row">
        <!-- Ảnh sản phẩm -->
        <div class="col-md-6 mb-4">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/no-image.png" : Model.ImageUrl)" 
                 class="img-fluid rounded shadow-sm w-100" 
                 style="max-height: 500px; object-fit: cover;" 
                 alt="@Model.Name" />
        </div>

        <!-- Chi tiết sản phẩm -->
        <div class="col-md-6">
            <h2 class="fw-bold mb-3">@Model.Name</h2>
            
            <p class="text-danger fs-3 fw-bold mb-3">
                @Model.Price.ToString("N0") ₫
            </p>

            <div class="mb-4">
                <span class="badge bg-secondary me-2 p-2">
                    <i class="fa fa-globe"></i> @Model.Country
                </span>
                <span class="badge bg-dark p-2">
                    <i class="fa fa-tag"></i> @(Model.Category?.Name ?? "Coffee")
                </span>
            </div>

            <div class="mb-4">
                <h5 class="fw-bold">Mô tả sản phẩm</h5>
                <p class="text-muted" style="line-height: 1.8;">
                    @(string.IsNullOrEmpty(Model.Description) ? "Hương vị cà phê nguyên bản, mang đến trải nghiệm tuyệt vời cho mỗi buổi sáng của bạn." : Model.Description)
                </p>
            </div>

            <hr />

            <!-- Hành động -->
            <div class="d-flex align-items-center mt-4">
                <a asp-controller="Cart" 
                   asp-action="AddToCart" 
                   asp-route-id="@Model.Id" 
                   class="btn btn-success btn-lg px-5 shadow-sm rounded-pill">
                    <i class="fa fa-cart-plus me-2"></i> Thêm vào giỏ hàng
                </a>
                
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg ms-3 rounded-pill">
                    <i class="fa fa-arrow-left me-2"></i> Quay lại
                </a>
            </div>
        </div>
    </div>
</div>