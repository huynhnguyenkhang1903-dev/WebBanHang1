@model Websitebanhang.Models.Product
@inject Websitebanhang.Repositores.IProductRepository ProductRepo

@{
    ViewData["Title"] = Model.Name;
    
    // Fetch related products from the repository directly in the view to avoid modifying backend logic
    var relatedProducts = ProductRepo.GetAll()
        .Where(p => p.CategoryId == Model.CategoryId && p.Id != Model.Id)
        .Take(4)
        .ToList();
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item"><a href="/Product" class="text-secondary">Cà Phê</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
            </ol>
        </nav>
    </div>

    <!-- Product Display -->
    <div class="col-12 mb-5">
        <div class="bg-white p-4 p-md-5 rounded-4 shadow-sm">
            <div class="row g-5 align-items-center">
                <!-- Left: Image -->
                <div class="col-md-6">
                    <div class="product-img-wrapper rounded-4 overflow-hidden shadow-sm position-relative">
                        @if (!string.IsNullOrEmpty(Model.Country))
                        {
                            <span class="badge bg-dark position-absolute top-0 start-0 m-3 z-index-2 px-3 py-2 fs-6 rounded-pill">
                                <i class="fa-solid fa-earth-americas me-2 text-gold"></i>@Model.Country
                            </span>
                        }
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl)" alt="@Model.Name" class="w-100 h-100 object-fit-cover transition-transform" />
                    </div>
                </div>

                <!-- Right: Information -->
                <div class="col-md-6">
                    <h1 class="display-5 text-coffee fw-bold mb-2">@Model.Name</h1>
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="text-warning">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                        </div>
                        <span class="text-muted small border-start ps-3">(150+ đánh giá)</span>
                    </div>

                    <div class="display-4 text-gold fw-bold mb-4">@Model.Price.ToString("N0") <span class="fs-4 text-secondary">₫</span></div>
                    
                    <p class="text-secondary fs-5 mb-5 lh-lg">
                        @(string.IsNullOrEmpty(Model.Description) ? "Dòng cà phê nguyên bản mang hương vị đậm đà, được chọn lọc kỹ càng từ những vùng trồng cà phê tốt nhất." : Model.Description)
                    </p>
                    
                    <div class="d-flex gap-3 align-items-center mb-4">
                        <span class="fw-medium text-dark"><i class="fa-solid fa-check text-success me-2"></i>Tình trạng:</span>
                        @if (Model.Stock > 0)
                        {
                            <span class="badge bg-success py-2 px-3">Còn hàng (@Model.Stock sẵn có)</span>
                        }
                        else
                        {
                            <span class="badge bg-danger py-2 px-3">Hết hàng</span>
                        }
                    </div>

                    @if (Model.Stock > 0)
                    {
                        <form action="/Cart/AddToCart" method="post" class="mt-4 border-top pt-4">
                            <input type="hidden" name="id" value="@Model.Id" />
                            
                            <div class="d-flex flex-column flex-sm-row gap-3">
                                <!-- Optional Quantity Selector for Display page -->
                                <div class="input-group" style="width: 150px;">
                                    <button class="btn btn-outline-secondary px-3" type="button" onclick="const q=document.getElementById('displayQty'); if(q.value>1)q.value--">-</button>
                                    <input id="displayQty" type="text" name="quantity" class="form-control text-center fw-bold" value="1" readonly>
                                    <button class="btn btn-outline-secondary px-3" type="button" onclick="const q=document.getElementById('displayQty'); if(q.value < @Model.Stock) q.value++">+</button>
                                </div>

                                <button type="submit" class="btn btn-primary-custom btn-lg flex-grow-1 shadow-sm fs-5">
                                    <i class="fa-solid fa-cart-arrow-down me-2"></i> Thêm Vào Giỏ Hàng
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="mt-4 border-top pt-4">
                            <button class="btn btn-secondary btn-lg w-100 shadow-sm fs-5" disabled>
                                <i class="fa-solid fa-phone me-2"></i> Liên Hệ Nhập Hàng
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (relatedProducts.Any())
    {
        <div class="col-12 mt-5 fade-in delay-1">
            <h3 class="text-coffee fw-bold border-bottom pb-3 mb-4">Sản Phẩm Cùng Loại</h3>
            <div class="row g-4">
                @foreach (var item in relatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <div class="product-card h-100">
                            <div class="product-img-wrapper bg-light">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)" alt="@item.Name" />
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <h6 class="mb-1 text-truncate pe-none">@item.Name</h6>
                                <div class="text-gold fw-bold mb-3 mt-auto">@item.Price.ToString("N0") ₫</div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm flex-grow-1">Xem</a>
                                    <form action="/Cart/AddToCart" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-gold btn-sm"><i class="fa-solid fa-cart-plus"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>