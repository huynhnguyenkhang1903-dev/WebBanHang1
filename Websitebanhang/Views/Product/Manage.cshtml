@model IEnumerable<Websitebanhang.Models.Product>

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa fa-coffee text-primary me-2"></i> Quản Lý Sản Phẩm</h2>
        <a asp-action="Add" class="btn btn-primary"><i class="fa fa-plus me-1"></i> Thêm Mới</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá (VNĐ)</th>
                            <th>Danh mục</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" onerror="this.onerror=null; this.src='/images/placeholder.jpg';" />
                                    }
                                    else
                                    {
                                        <img src="/images/placeholder.jpg" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" onerror="this.onerror=null;" />
                                    }
                                </td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-success fw-bold">@item.Price.ToString("N0") ₫</td>
                                <td>@(item.Category != null ? item.Category.Name : "Không có")</td>
                                <td>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fa fa-edit"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>