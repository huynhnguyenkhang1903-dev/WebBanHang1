@model X.PagedList.IPagedList<Websitebanhang.Models.Product>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Quản Lý Sản Phẩm";
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa fa-coffee text-primary me-2"></i> Quản Lý Sản Phẩm</h2>
        <a asp-action="Add" class="btn btn-primary"><i class="fa fa-plus me-1"></i> Thêm Mới</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Manage" method="get" class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="fa fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control border-start-0" placeholder="Tìm tên sản phẩm...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select">
                        <option value="">-- Tất cả danh mục --</option>
                        @foreach (var cat in ViewBag.Categories)
                        {
                            <option value="@cat.Id" selected="@(ViewBag.CurrentCategory == cat.Id ? "selected" : null)">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select name="hasPromotion" class="form-select">
                        <option value="">-- Tất cả sản phẩm --</option>
                        <option value="true" selected="@(ViewBag.CurrentPromotion == true ? "selected" : null)">Đang khuyến mãi</option>
                        <option value="false" selected="@(ViewBag.CurrentPromotion == false ? "selected" : null)">Không khuyến mãi</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-dark w-100">Lọc</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Ảnh</th>
                            <th><a asp-action="Manage" asp-route-sortOrder="@ViewBag.NameSortParm" class="text-dark text-decoration-none">Tên sản phẩm <i class="fa-solid fa-sort small ms-1"></i></a></th>
                            <th><a asp-action="Manage" asp-route-sortOrder="@ViewBag.PriceSortParm" class="text-dark text-decoration-none">Giá (VNĐ) <i class="fa-solid fa-sort small ms-1"></i></a></th>
                            <th>Danh mục</th>
                            <th><a asp-action="Manage" asp-route-sortOrder="@ViewBag.UnitSortParm" class="text-dark text-decoration-none">Đơn vị <i class="fa-solid fa-sort small ms-1"></i></a></th>
                            <th>Tồn kho</th>
                            <th>Hạn sử dụng</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var isExpired = item.ExpiryDate.HasValue && item.ExpiryDate.Value <= DateTime.Now;
                            var isNearExpiry = item.ExpiryDate.HasValue && !isExpired && item.ExpiryDate.Value <= DateTime.Now.AddDays(30);
                            
                            <tr class="@(isExpired ? "table-danger" : (isNearExpiry ? "table-warning" : ""))">
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover;" class="rounded" onerror="this.onerror=null; this.src='https://placehold.co/100x100?text=No+Img';" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted border" style="width: 50px; height: 50px;">
                                            <i class="fa-regular fa-image" style="font-size: 12px;"></i>
                                        </div>
                                    }
                                </td>
                                <td class="fw-bold">@item.Name</td>
                                <td class="text-success fw-bold">@item.Price.ToString("N0") ₫</td>
                                <td>@(item.Category != null ? item.Category.Name : "Không có")</td>
                                <td><span class="badge bg-light text-dark">@item.Unit</span></td>
                                <td>
                                    @if (item.Stock > 0)
                                    {
                                        <span class="badge bg-success">@item.Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Hết hàng</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ExpiryDate.HasValue)
                                    {
                                        <span class="small @(isExpired ? "text-danger fw-bold" : (isNearExpiry ? "text-dark fw-bold" : "text-muted"))">
                                            @item.ExpiryDate.Value.ToString("dd/MM/yyyy")
                                            @if (isExpired) { <br/><small>(Hết hạn)</small> }
                                            else if (isNearExpiry) { <br/><small>(Sắp hết hạn)</small> }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">N/A</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="ManageAttributes" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Thuộc tính">
                                        <i class="fa-solid fa-list"></i> Thuộc tính
                                    </a>
                                    <a asp-controller="AdminProductImage" asp-action="Index" asp-route-productId="@item.Id" class="btn btn-sm btn-outline-info" title="Quản lý hình ảnh">
                                        <i class="fa-solid fa-images"></i> Ảnh
                                    </a>
                                    <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fa fa-edit"></i> Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i> Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.PageCount > 1)
    {
        <div class="mt-4 d-flex justify-content-center">
            @Html.PagedListPager(Model, page => Url.Action("Manage", new { page, sortOrder = ViewBag.CurrentSort, search = ViewBag.CurrentSearch, hasPromotion = ViewBag.CurrentPromotion, categoryId = ViewBag.CurrentCategory }), new PagedListRenderOptions
            {
                LiElementClasses = new string[] { "page-item" },
                PageClasses = new string[] { "page-link" }
            })
        </div>
    }
</div>