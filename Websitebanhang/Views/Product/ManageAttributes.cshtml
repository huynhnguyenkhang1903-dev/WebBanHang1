@model Websitebanhang.Models.Product
@{
    ViewData["Title"] = "Quản lý thuộc tính: " + Model.Name;
    Layout = "_AdminLayout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa-solid fa-list text-primary me-2"></i> Quản lý thuộc tính</h2>
        <a asp-action="Manage" class="btn btn-outline-secondary"><i class="fa fa-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">Sản phẩm: <span class="text-primary">@Model.Name</span></h5>
        </div>
        <div class="card-body">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <div class="row">
                <!-- Thêm thuộc tính -->
                <div class="col-md-4 mb-4">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">Thêm Thuộc Tính Mới</h6>
                            <form asp-action="AddAttribute" method="post">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Tên thuộc tính (VD: RAM, Màu sắc...)</label>
                                    <input type="text" name="name" class="form-control" required placeholder="Nhập tên thuộc tính" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold">Giá trị (VD: 8GB, Đen...)</label>
                                    <input type="text" name="value" class="form-control" required placeholder="Nhập giá trị" />
                                </div>
                                <button type="submit" class="btn btn-primary w-100"><i class="fa fa-plus me-1"></i> Thêm Thuộc Tính</button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Danh sách thuộc tính -->
                <div class="col-md-8">
                    @if (Model.Attributes == null || !Model.Attributes.Any())
                    {
                        <div class="text-center py-5 border rounded bg-light">
                            <i class="fa-solid fa-box-open fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Chưa có thuộc tính nào</h5>
                            <p class="text-muted small">Hãy thêm các thông số kỹ thuật hoặc đặc điểm cho sản phẩm này.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="w-25">Tên thuộc tính</th>
                                        <th>Giá trị</th>
                                        <th class="text-center" style="width: 100px;">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attr in Model.Attributes)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">@attr.Name</td>
                                            <td>@attr.Value</td>
                                            <td class="text-center">
                                                <form asp-action="DeleteAttribute" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa thuộc tính này?');">
                                                    <input type="hidden" name="attributeId" value="@attr.Id" />
                                                    <input type="hidden" name="productId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                        <i class="fa fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
