@using X.PagedList
@using X.PagedList.Mvc.Core
@using ProductModel = Websitebanhang.Models.Product
@model X.PagedList.IPagedList<ProductModel>

<div class="container mt-4">
    <h2 class="text-center mb-4 fw-bold">☕ Sản phẩm Cà Phê</h2>

    <!-- SEARCH + FILTER -->
    <form method="get" asp-action="Index" class="row mb-4 g-2">
        @if (Context.Request.Query.ContainsKey("categoryId"))
        {
            <input type="hidden" name="categoryId" value="@Context.Request.Query["categoryId"]" />
        }

        <div class="col-md-4">
            <input type="text"
                   name="search"
                   class="form-control"
                   placeholder="Tìm kiếm cà phê..."
                   value="@Context.Request.Query["search"].ToString()" />
        </div>

        <div class="col-md-3">
            <select name="price" class="form-select">
                <option value="">Lọc theo giá</option>
                <option value="low" selected="@(Context.Request.Query["price"] == "low" ? "selected" : null)">Giá thấp</option>
                <option value="medium" selected="@(Context.Request.Query["price"] == "medium" ? "selected" : null)">Giá trung bình</option>
                <option value="high" selected="@(Context.Request.Query["price"] == "high" ? "selected" : null)">Giá cao</option>
            </select>
        </div>

        <div class="col-md-3">
            <select name="country" class="form-select">
                <option value="">Xuất xứ</option>
                <option value="Vietnam" selected="@(Context.Request.Query["country"] == "Vietnam" ? "selected" : null)">Việt Nam</option>
                <option value="Brazil" selected="@(Context.Request.Query["country"] == "Brazil" ? "selected" : null)">Brazil</option>
                <option value="Colombia" selected="@(Context.Request.Query["country"] == "Colombia" ? "selected" : null)">Colombia</option>
                <option value="Ethiopia" selected="@(Context.Request.Query["country"] == "Ethiopia" ? "selected" : null)">Ethiopia</option>
                <option value="Indonesia" selected="@(Context.Request.Query["country"] == "Indonesia" ? "selected" : null)">Indonesia</option>
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-dark w-100">
                Tìm kiếm
            </button>
        </div>
    </form>

    <!-- PRODUCT GRID -->
    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm border-0 rounded-3">

                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;"
                             alt="@item.Name" />

                        <div class="card-body text-center">
                            <h6 class="fw-bold">@item.Name</h6>

                            <p class="text-danger fw-bold mb-1">
                                @item.Price.ToString("N0") ₫
                            </p>

                            <p class="text-muted small mb-3">
                                @item.Country
                            </p>

                            <div class="d-grid gap-2">
                                <a asp-action="Display"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-dark btn-sm">
                                    Xem chi tiết
                                </a>

                                <a asp-controller="Cart"
                                   asp-action="AddToCart"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success btn-sm">
                                    🛒 Thêm vào giỏ
                                </a>
                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    Không tìm thấy sản phẩm nào.
                </div>
            </div>
        }
    </div>

    <!-- PAGINATION -->
    @if (Model != null && Model.PageCount > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            @Html.PagedListPager(
                Model,
                page => Url.Action("Index", new
                {
                    page,
                    categoryId = Context.Request.Query["categoryId"].ToString(),
                    search = Context.Request.Query["search"].ToString(),
                    price = Context.Request.Query["price"].ToString(),
                    country = Context.Request.Query["country"].ToString()
                }),
                new PagedListRenderOptions
                {
                    LiElementClasses = new[] { "page-item" },
                    PageClasses = new[] { "page-link" }
                }
            )
        </div>
    }
</div>