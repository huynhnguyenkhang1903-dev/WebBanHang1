@model X.PagedList.IPagedList<Websitebanhang.Models.Product>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Thực Đơn Cà Phê";
    var currentSort = Context.Request.Query["sortOrder"].ToString();
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item active">Hạt Cà Phê</li>
            </ol>
        </nav>
        <h2 class="text-coffee mt-2 fw-bold">Khám Phá Cà Phê</h2>
    </div>

    <!-- SIDEBAR -->
    <div class="col-lg-3 mb-4">
        <div class="bg-white p-4 rounded-4 shadow-sm sticky-top" style="top:100px;">
            <h5 class="fw-bold mb-4 text-coffee"><i class="fa-solid fa-filter me-2"></i>Bộ Lọc</h5>

            <form method="get">
                <div class="mb-3">
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tên cà phê...">
                </div>

                @{
                    var currentPrice = Context.Request.Query["price"].ToString();
                }

                <select name="price" class="form-select mb-3">
                    <option value="">Tất cả giá</option>
                    <option value="low" selected="@(currentPrice == "low")">Dưới 100k</option>
                    <option value="medium" selected="@(currentPrice == "medium")">100k - 300k</option>
                    <option value="high" selected="@(currentPrice == "high")">Trên 300k</option>
                </select>

                @{
                    var currentCountry = Context.Request.Query["country"].ToString();
                }

                <select name="country" class="form-select mb-3">
                    <option value="">Tất cả quốc gia</option>
                    <option value="Vietnam" selected="@(currentCountry == "Vietnam")">Việt Nam</option>
                    <option value="Brazil" selected="@(currentCountry == "Brazil")">Brazil</option>
                    <option value="Colombia" selected="@(currentCountry == "Colombia")">Colombia</option>
                </select>

                <button class="btn btn-primary w-100">Lọc</button>
            </form>
        </div>
    </div>

    <!-- MAIN -->
    <div class="col-lg-9">

        <!-- HEADER + SORT -->
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm flex-wrap gap-2">

            <span>
                Hiển thị <b>@Model.Count</b> / @Model.TotalItemCount sản phẩm
            </span>

            <form method="get" class="d-flex gap-2">
                <!-- giữ filter -->
                <input type="hidden" name="search" value="@Context.Request.Query["search"]" />
                <input type="hidden" name="price" value="@Context.Request.Query["price"]" />
                <input type="hidden" name="country" value="@Context.Request.Query["country"]" />

                <select name="sortOrder" class="form-select form-select-sm">
                    <option value="">-- Sắp xếp --</option>
                    <option value="name" selected="@(currentSort == "name")">Tên A-Z</option>
                    <option value="name_desc" selected="@(currentSort == "name_desc")">Tên Z-A</option>
                    <option value="price" selected="@(currentSort == "price")">Giá tăng</option>
                    <option value="price_desc" selected="@(currentSort == "price_desc")">Giá giảm</option>
                </select>

                <button class="btn btn-dark btn-sm">OK</button>
            </form>
        </div>

        <!-- PRODUCTS -->
        <div class="row g-4">
            @if (Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="card h-100 shadow-sm position-relative">
                            <a asp-controller="Wishlist" asp-action="Add" asp-route-id="@item.Id" asp-route-returnUrl="@Context.Request.Path"
                               class="position-absolute top-0 end-0 m-2 btn btn-light btn-sm rounded-circle shadow-sm z-index-3 text-danger" style="z-index: 3;" title="Thêm vào yêu thích">
                                <i class="fa-regular fa-heart"></i>
                            </a>
                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)" class="card-img-top" />
                            <div class="card-body">
                                <h6>@item.Name</h6>
                                <b class="text-danger">@item.Price.ToString("N0") ₫</b>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p>Không có sản phẩm</p>
            }
        </div>

        <!-- PAGINATION -->
        @if (Model.PageCount > 1)
        {
            <div class="mt-4 text-center">
                @Html.PagedListPager(Model, page => Url.Action("Index", new
                {
                    page,
                        search = Context.Request.Query["search"],
                        price = Context.Request.Query["price"],
                        country = Context.Request.Query["country"],
                        sortOrder = Context.Request.Query["sortOrder"]
                        }))
        </div>
                }
    </div>
</div>