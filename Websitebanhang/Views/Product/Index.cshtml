@using X.PagedList
@using X.PagedList.Mvc.Core
@model IPagedList<Websitebanhang.Models.Product>

<div class="container mt-4">

<h2 class="text-center mb-4 fw-bold">☕ Coffee Products</h2>

<!-- SEARCH + FILTER -->
<form method="get" class="row mb-4">

<div class="col-md-4">
<input type="text" name="search" class="form-control"
placeholder="Search coffee..."
value="@Context.Request.Query["search"]" />
</div>

<div class="col-md-3">
<select name="price" class="form-select">

<option value="">Price</option>

<option value="low" selected="@(Context.Request.Query["price"] == "low")">
Low price
</option>

<option value="medium" selected="@(Context.Request.Query["price"] == "medium")">
Medium price
</option>

<option value="high" selected="@(Context.Request.Query["price"] == "high")">
High price
</option>

</select>
</div>

<div class="col-md-3">
<select name="country" class="form-select">

<option value="">Country</option>

<option value="Vietnam" selected="@(Context.Request.Query["country"] == "Vietnam")">
Vietnam
</option>

<option value="Brazil" selected="@(Context.Request.Query["country"] == "Brazil")">
Brazil
</option>

<option value="Colombia" selected="@(Context.Request.Query["country"] == "Colombia")">
Colombia
</option>

<option value="Ethiopia" selected="@(Context.Request.Query["country"] == "Ethiopia")">
Ethiopia
</option>

<option value="Indonesia" selected="@(Context.Request.Query["country"] == "Indonesia")">
Indonesia
</option>

</select>
</div>

<div class="col-md-2">
<button class="btn btn-dark w-100">
Search
</button>
</div>

</form>


<!-- PRODUCT GRID -->
<div class="row">

@foreach(var item in Model)
{
<div class="col-lg-2 col-md-3 col-sm-6 mb-4">

<div class="card product-card h-100 shadow-sm">

<img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/no-image.png" : item.ImageUrl)"
class="card-img-top product-img"
alt="@item.Name">

<div class="card-body text-center">

<h6 class="fw-bold">@item.Name</h6>

<p class="text-danger fw-bold">
@item.Price.ToString("N0") đ
</p>

<p class="text-muted small">
@item.Country
</p>

<div class="d-grid gap-2">

<a asp-action="Display"
asp-route-id="@item.Id"
class="btn btn-outline-dark btn-sm">
View
</a>

<a asp-controller="Cart"
   asp-action="AddToCart"
   asp-route-id="@item.Id"
   class="btn btn-success">
🛒 Add To Cart
</a>

</div>

</div>

</div>

</div>
}

</div>


<!-- PAGINATION -->
<div class="d-flex justify-content-center mt-4">

@Html.PagedListPager(
Model,
page => Url.Action("Index", new {
page,
search = Context.Request.Query["search"],
price = Context.Request.Query["price"],
country = Context.Request.Query["country"]
}),
new PagedListRenderOptions
{
LiElementClasses = new[] { "page-item" },
PageClasses = new[] { "page-link" }
})

</div>

</div>