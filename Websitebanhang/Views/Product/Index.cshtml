@model X.PagedList.IPagedList<Websitebanhang.Models.Product>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Thực Đơn Cà Phê";
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item active" aria-current="page">Hạt Cà Phê</li>
            </ol>
        </nav>
        <h2 class="text-coffee mt-2 fw-bold">Khám Phá Cà Phê</h2>
    </div>

    <!-- SIDEBAR FILTER -->
    <div class="col-lg-3 mb-4">
        <div class="bg-white p-4 rounded-4 shadow-sm border-0 sticky-top" style="top: 100px; z-index: 10;">
            <h5 class="fw-bold mb-4 text-coffee"><i class="fa-solid fa-filter me-2"></i>Bộ Lọc</h5>
            
            <form method="get" action="/Product/Index">
                <!-- Search -->
                <div class="mb-4">
                    <label class="form-label fw-medium text-secondary">Tên sản phẩm</label>
                    <input type="text" name="search" value="@Context.Request.Query["search"]" class="form-control" placeholder="Tên cà phê...">
                </div>

                <!-- Price -->
                <div class="mb-4">
                    <label class="form-label fw-medium text-secondary">Khoảng Giá</label>
                    @{ var currentPrice = Context.Request.Query["price"].ToString(); }
                    <select name="price" class="form-select">
                        <option value="">Tất cả mức giá</option>
                        <option value="low" selected="@(currentPrice == "low")">Dưới 100.000 ₫</option>
                        <option value="medium" selected="@(currentPrice == "medium")">100.000 ₫ - 300.000 ₫</option>
                        <option value="high" selected="@(currentPrice == "high")">Trên 300.000 ₫</option>
                    </select>
                </div>

                <!-- Country -->
                <div class="mb-4">
                    <label class="form-label fw-medium text-secondary">Quốc Gia</label>
                    @{ var currentCountry = Context.Request.Query["country"].ToString(); }
                    <select name="country" class="form-select">
                        <option value="">Tất cả</option>
                        <option value="Vietnam" selected="@(currentCountry == "Vietnam")">Việt Nam</option>
                        <option value="Ethiopia" selected="@(currentCountry == "Ethiopia")">Ethiopia</option>
                        <option value="Colombia" selected="@(currentCountry == "Colombia")">Colombia</option>
                        <option value="Brazil" selected="@(currentCountry == "Brazil")">Brazil</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100"><i class="fa-solid fa-check me-2"></i>Áp dụng bộ lọc</button>
                <a href="/Product/Index" class="btn btn-outline-secondary w-100 mt-2">Xóa bộ lọc</a>
            </form>
        </div>
    </div>

    <!-- MAIN GRID -->
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm">
            <span class="text-muted">Hiển thị <strong class="text-coffee">@Model.Count</strong> / @Model.TotalItemCount sản phẩm</span>
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary active"><i class="fa-solid fa-grid-2"></i></button>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <!-- 4-Column logic on large screens: col-lg-3 (12/4 = 3) -->
                    <div class="col-6 col-md-4 col-xl-3">
                        <div class="product-card h-100">
                            <div class="product-img-wrapper bg-light">
                                @if (!string.IsNullOrEmpty(item.Country))
                                {
                                    <span class="badge-category shadow-sm"><i class="fa-solid fa-earth-americas me-1"></i>@item.Country</span>
                                }
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.jpg" : item.ImageUrl)" alt="@item.Name" />
                            </div>
                            <div class="p-3 d-flex flex-column flex-grow-1">
                                <h6 class="mb-1 text-truncate pe-none">@item.Name</h6>
                                <div class="text-gold fw-bold mb-3 mt-auto fs-5">@item.Price.ToString("N0") ₫</div>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Product" asp-action="Display" asp-route-id="@item.Id" class="btn btn-outline-dark btn-sm flex-grow-1">Chi tiết</a>
                                    <form action="/Cart/AddToCart" method="post" class="m-0">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-gold btn-sm"><i class="fa-solid fa-cart-plus"></i></button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm text-muted">
                    <i class="fa-solid fa-magnifying-glass fs-1 mb-3"></i>
                    <p class="fs-5">Không tìm thấy sản phẩm nào phù hợp với bộ lọc của bạn.</p>
                </div>
            }
        </div>

        <!-- PAGINATION -->
        @if (Model != null && Model.PageCount > 1)
        {
            <div class="d-flex justify-content-center mt-5">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-lg align-items-center shadow-sm rounded-pill bg-white px-3 py-2">
                        @if (Model.HasPreviousPage)
                        {
                            <li class="page-item">
                                <a class="page-link border-0 text-coffee bg-transparent fw-bold" href="@Url.Action("Index", new { page = Model.PageNumber - 1, search = Context.Request.Query["search"], price = Context.Request.Query["price"], country = Context.Request.Query["country"], categoryId = Context.Request.Query["categoryId"] })"><i class="fa-solid fa-chevron-left"></i></a>
                            </li>
                        }

                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link border-0 @(i == Model.PageNumber ? "bg-coffee text-white rounded-circle shadow-sm" : "text-dark bg-transparent") fw-medium mx-1" href="@Url.Action("Index", new { page = i, search = Context.Request.Query["search"], price = Context.Request.Query["price"], country = Context.Request.Query["country"], categoryId = Context.Request.Query["categoryId"] })" style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">@i</a>
                            </li>
                        }

                        @if (Model.HasNextPage)
                        {
                            <li class="page-item">
                                <a class="page-link border-0 text-coffee bg-transparent fw-bold" href="@Url.Action("Index", new { page = Model.PageNumber + 1, search = Context.Request.Query["search"], price = Context.Request.Query["price"], country = Context.Request.Query["country"], categoryId = Context.Request.Query["categoryId"] })"><i class="fa-solid fa-chevron-right"></i></a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>