@model IEnumerable<Websitebanhang.Models.Voucher>

@{
    ViewData["Title"] = "Quản lý Voucher";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-danger">
            <i class="fa-solid fa-ticket-simple me-2"></i> Quản lý Voucher
        </h2>
        <a asp-action="Create" class="btn btn-danger fw-bold shadow-sm rounded-pill px-4">
            <i class="fa-solid fa-plus me-2"></i> Thêm Voucher Mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã Voucher</th>
                            <th>Giảm giá</th>
                            <th>Ngày hết hạn</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">Chưa có dữ liệu voucher.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            var isExpired = item.ExpiryDate < DateTime.Now;
                            <tr>
                                <td class="ps-4">
                                    <span class="badge bg-light text-danger border border-danger px-3 py-2 fs-6">@item.Code</span>
                                </td>
                                <td>
                                    <div class="fw-bold text-success fs-5">@item.DiscountPercent%</div>
                                </td>
                                <td>
                                    <div class="@(isExpired ? "text-danger" : "text-dark")">
                                        <i class="fa-regular fa-calendar-days me-2"></i>@item.ExpiryDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary">Hết hạn</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Còn hiệu lực</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa voucher này?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
