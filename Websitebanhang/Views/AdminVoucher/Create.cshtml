@model Websitebanhang.Models.Voucher

@{
    ViewData["Title"] = "Thêm Voucher Mới";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h5 class="card-title mb-0 fw-bold"><i class="fa-solid fa-plus me-2"></i> Thêm Voucher Mới</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-bold">Mã Voucher</label>
                            <input asp-for="Code" class="form-control" placeholder="Ví dụ: GIAM20, COFFEE50..." required />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DiscountPercent" class="form-label fw-bold">Phần trăm giảm giá (%)</label>
                            <div class="input-group">
                                <input asp-for="DiscountPercent" type="number" class="form-control" min="1" max="100" required />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="DiscountPercent" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ExpiryDate" class="form-label fw-bold">Ngày hết hạn</label>
                            <input asp-for="ExpiryDate" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="ExpiryDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold">
                                <i class="fa-solid fa-save me-2"></i> Lưu Voucher
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
