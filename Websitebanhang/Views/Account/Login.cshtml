@model Websitebanhang.Models.ViewModels.LoginViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <h2 class="text-center mb-4">Đăng Nhập</h2>
            <div class="card shadow-sm p-4">
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" placeholder="Nhập Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" type="password" placeholder="Nhập mật khẩu" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label class="form-check-label" asp-for="RememberMe">
                        Ghi nhớ đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn btn-success w-100">Đăng Nhập</button>
                
                <div class="mt-3 text-center">
                    <a asp-action="ForgotPassword" class="text-muted text-decoration-none">Quên mật khẩu?</a>
                </div>
                
                <div class="mt-3 text-center">
                    <span>Bạn chưa có tài khoản?</span>
                    <a asp-action="Register">Đăng ký ngay</a>
                </div>
            </form>
            
            <hr class="my-4" />
            <div class="text-center mb-3">Hoặc đăng nhập bằng</div>
            <form asp-action="ExternalLogin" method="post" class="d-flex flex-column gap-2">
                <button type="submit" class="btn btn-outline-danger w-100" name="provider" value="Google">
                    Đăng nhập bằng Google
                </button>
                <button type="submit" class="btn btn-outline-primary w-100" name="provider" value="Facebook">
                    Đăng nhập bằng Facebook
                </button>
            </form>
            </div>
        </div>
    </div>
</div>