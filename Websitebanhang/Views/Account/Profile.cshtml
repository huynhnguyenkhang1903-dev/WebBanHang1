@model Websitebanhang.Models.ViewModels.ProfileViewModel
@inject Microsoft.AspNetCore.Identity.UserManager<Websitebanhang.Models.ApplicationUser> UserManager
@{
    ViewData["Title"] = "Hồ Sơ Của Tôi";
    var currentUser = await UserManager.GetUserAsync(User);
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item"><a href="/" class="text-secondary"><i class="fa-solid fa-house"></i></a></li>
                <li class="breadcrumb-item active" aria-current="page">Hồ Sơ Của Tôi</li>
            </ol>
        </nav>
    </div>

    <div class="col-12">
        <div class="bg-white rounded-4 shadow-sm overflow-hidden d-flex flex-column flex-md-row">
            
            <!-- Left Sidebar -->
            <div class="bg-light p-4 col-md-4 col-lg-3 border-end">
                <div class="text-center mb-4">
                    <!-- Avatar Area -->
                    <div class="position-relative d-inline-block">
                        @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                        {
                            <img src="@currentUser.AvatarUrl" alt="Avatar" class="rounded-circle shadow-sm object-fit-cover" style="width: 120px; height: 120px; border: 4px solid var(--cream);" />
                        }
                        else
                        {
                            <div class="rounded-circle shadow-sm bg-coffee text-white d-flex align-items-center justify-content-center mx-auto" style="width: 120px; height: 120px; border: 4px solid var(--cream);">
                                <i class="fa-solid fa-user display-3"></i>
                            </div>
                        }
                        
                        <!-- Overlay Button -->
                        <a asp-controller="Account" asp-action="UploadAvatar" class="btn btn-sm btn-gold position-absolute bottom-0 end-0 rounded-circle shadow text-white d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; text-decoration: none;" title="Thay đổi ảnh đại diện">
                            <i class="fa-solid fa-camera"></i>
                        </a>
                    </div>
                    
                    <h5 class="fw-bold text-coffee mt-3 mb-1">@(Model?.FullName ?? User.Identity?.Name ?? "Tài Khoản")</h5>
                    <p class="text-muted small">Thành viên thân thiết</p>
                </div>

                <!-- Delete avatar button -->
                @if (currentUser != null && !string.IsNullOrEmpty(currentUser.AvatarUrl))
                {
                    <form asp-controller="Account" asp-action="DeleteAvatar" method="post" class="text-center mt-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">Xóa ảnh đại diện</button>
                    </form>
                }

                <!-- Vertical Tabs Menu -->
                <div class="nav flex-column nav-pills custom-tabs" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                    <button class="nav-link active text-start fw-medium rounded-3 mb-2" id="v-pills-info-tab" data-bs-toggle="pill" data-bs-target="#v-pills-info" type="button" role="tab">
                        <i class="fa-regular fa-id-card me-2 w-20px text-center"></i> Thông Tin Cơ Bản
                    </button>
                    <button class="nav-link text-start fw-medium rounded-3 mb-2" id="v-pills-password-tab" data-bs-toggle="pill" data-bs-target="#v-pills-password" type="button" role="tab">
                        <i class="fa-solid fa-shield-halved me-2 w-20px text-center"></i> Đổi Mật Khẩu
                    </button>
                    <button class="nav-link text-start fw-medium rounded-3 mb-2" id="v-pills-address-tab" data-bs-toggle="pill" data-bs-target="#v-pills-address" type="button" role="tab">
                        <i class="fa-solid fa-map-location-dot me-2 w-20px text-center"></i> Sổ Địa Chỉ
                    </button>
                    <button class="nav-link text-start fw-medium rounded-3" id="v-pills-orders-tab" data-bs-toggle="pill" data-bs-target="#v-pills-orders" type="button" role="tab">
                        <i class="fa-solid fa-receipt me-2 w-20px text-center"></i> Lịch Sử Đơn Hàng
                    </button>
                </div>
            </div>

            <!-- Right Content -->
            <div class="p-4 p-md-5 col-md-8 col-lg-9">
                <div class="tab-content" id="v-pills-tabContent">
                    
                    <!-- TAB: Information -->
                    <div class="tab-pane fade show active" id="v-pills-info" role="tabpanel">
                        <h4 class="text-coffee fw-bold mb-4 border-bottom pb-2">Thông Tin Của Tôi</h4>
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success fs-6"><i class="fa fa-check-circle me-1"></i>@TempData["SuccessMessage"]</div>
                        }
                        
                        <form asp-controller="Account" asp-action="Profile" method="post">
                            <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3 form-floating">
                                    <input type="text" class="form-control" name="FullName" id="FullName" value="@(Model?.FullName)" placeholder="Họ và tên">
                                    <label for="FullName" class="ps-4">Họ và tên</label>
                                </div>
                                <div class="col-md-6 mb-3 form-floating">
                                    <input type="text" class="form-control" name="UserName" id="UserName" value="@(Model?.UserName)" placeholder="Tên hiển thị">
                                    <label for="UserName" class="ps-4">Tên hiển thị</label>
                                </div>
                                <div class="col-md-12 mb-3 form-floating">
                                    <input type="email" class="form-control" name="Email" id="Email" value="@(Model?.Email)" placeholder="Email">
                                    <label for="Email" class="ps-4">Email</label>
                                </div>
                                <div class="col-md-12 mb-4 form-floating">
                                    <input type="tel" class="form-control" name="PhoneNumber" id="PhoneNumber" value="@(Model?.PhoneNumber)" placeholder="Số điện thoại">
                                    <label for="PhoneNumber" class="ps-4">Số điện thoại</label>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary-custom px-4 rounded-pill">Lưu Thay Đổi</button>
                        </form>
                    </div>

                    <!-- TAB: Change Password -->
                    <div class="tab-pane fade" id="v-pills-password" role="tabpanel">
                        <h4 class="text-coffee fw-bold mb-4 border-bottom pb-2">Đổi Mật Khẩu</h4>
                        <form asp-controller="Account" asp-action="ChangePassword" method="post">
                            <div class="mb-3 form-floating">
                                <input type="password" class="form-control" name="OldPassword" id="OldPassword" placeholder="Mật khẩu hiện tại" required>
                                <label for="OldPassword" class="ps-4">Mật khẩu hiện tại</label>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6 mb-3 form-floating">
                                    <input type="password" class="form-control" name="NewPassword" id="NewPassword" placeholder="Mật khẩu mới" required>
                                    <label for="NewPassword" class="ps-4">Mật khẩu mới</label>
                                </div>
                                <div class="col-md-6 mb-4 form-floating">
                                    <input type="password" class="form-control" name="ConfirmPassword" id="ConfirmPassword" placeholder="Xác nhận mật khẩu" required>
                                    <label for="ConfirmPassword" class="ps-4">Xác nhận mật khẩu mới</label>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary-custom px-4 rounded-pill">Cập Nhật Mật Khẩu</button>
                        </form>
                    </div>

                    <!-- TAB: Address Book -->
                    <div class="tab-pane fade" id="v-pills-address" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
                            <h4 class="text-coffee fw-bold mb-0">Sổ Địa Chỉ</h4>
                            <button type="button" class="btn btn-primary-custom rounded-pill px-3 py-1" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="fa-solid fa-plus me-1"></i> Thêm địa chỉ mới
                            </button>
                        </div>
                        
                        @if (Model?.Addresses != null && Model.Addresses.Any())
                        {
                            <div class="row g-3">
                                @foreach (var addr in Model.Addresses)
                                {
                                    <div class="col-md-12">
                                        <div class="card h-100 border @(addr.IsDefault ? "border-warning shadow-sm" : "")">
                                            <div class="card-body position-relative">
                                                @if (addr.IsDefault)
                                                {
                                                    <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">Mặc định</span>
                                                }
                                                <h6 class="card-title fw-bold text-coffee mb-1">@addr.FullName</h6>
                                                <p class="card-text small text-muted mb-2"><i class="fa-solid fa-phone me-1"></i> @addr.PhoneNumber</p>
                                                <p class="card-text mb-3">@addr.AddressLine</p>
                                                
                                                <div class="d-flex gap-2">
                                                    <!-- Edit Button -->
                                                    <button class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editAddressModal_@addr.Id">
                                                        <i class="fa-regular fa-pen-to-square"></i> Sửa
                                                    </button>
                                                    
                                                    <!-- Delete Form -->
                                                    <form asp-action="DeleteAddress" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa chỉ này?');">
                                                        <input type="hidden" name="id" value="@addr.Id" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                                            <i class="fa-regular fa-trash-can"></i> Xóa
                                                        </button>
                                                    </form>
                                                    
                                                    <!-- Set Default Form -->
                                                    @if (!addr.IsDefault)
                                                    {
                                                        <form asp-action="SetDefaultAddress" method="post">
                                                            <input type="hidden" name="id" value="@addr.Id" />
                                                            <button type="submit" class="btn btn-sm btn-outline-primary">Thiết lập mặc định</button>
                                                        </form>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Edit Address Modal -->
                                    <div class="modal fade" id="editAddressModal_@addr.Id" tabindex="-1">
                                      <div class="modal-dialog">
                                        <div class="modal-content">
                                          <form asp-action="EditAddress" method="post">
                                              <input type="hidden" name="id" value="@addr.Id" />
                                              <div class="modal-header">
                                                <h5 class="modal-title text-coffee">Chỉnh sửa địa chỉ</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                              </div>
                                              <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Họ và tên</label>
                                                    <input type="text" class="form-control" name="FullName" value="@addr.FullName" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Số điện thoại</label>
                                                    <input type="tel" class="form-control" name="PhoneNumber" value="@addr.PhoneNumber" required />
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label">Địa chỉ cụ thể</label>
                                                    <textarea class="form-control" name="AddressLine" rows="3" required>@addr.AddressLine</textarea>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="IsDefault" value="true" @(addr.IsDefault ? "checked" : "") id="checkDefault_@addr.Id">
                                                    <label class="form-check-label" for="checkDefault_@addr.Id">Đặt làm địa chỉ mặc định</label>
                                                </div>
                                              </div>
                                              <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="submit" class="btn btn-primary-custom">Lưu thay đổi</button>
                                              </div>
                                          </form>
                                        </div>
                                      </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa-regular fa-map text-muted mb-3" style="font-size: 3rem;"></i>
                                <h5 class="text-muted">Bạn chưa có địa chỉ nào</h5>
                                <p class="text-secondary">Thêm địa chỉ giao hàng để thuận tiện hơn khi đặt hàng.</p>
                            </div>
                        }
                    </div>

                    <!-- TAB: Order History -->
                    <div class="tab-pane fade" id="v-pills-orders" role="tabpanel">
                        <h4 class="text-coffee fw-bold mb-4 border-bottom pb-2">Lịch Sử Đơn Hàng</h4>
                        
                        @if (Model?.Orders != null && Model.Orders.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Mã Đơn</th>
                                            <th>Ngày Đặt</th>
                                            <th>Tổng Tiền</th>
                                            <th>Trạng Thái</th>
                                            <th>Thao Tác</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in Model.Orders)
                                        {
                                            <tr>
                                                <td class="fw-bold">#ORD-@order.Id.ToString("D3")</td>
                                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td class="text-gold fw-bold">@order.TotalAmount.ToString("N0") ₫</td>
                                                <td>
                                                    @if (order.Status == "Pending")
                                                    {
                                                        <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                                    }
                                                    else if (order.Status == "Hoàn thành")
                                                    {
                                                        <span class="badge bg-success">Hoàn thành</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">@order.Status</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">Chi tiết</a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="fa-solid fa-box-open text-muted mb-3" style="font-size: 3rem;"></i>
                                <h5 class="text-muted">Bạn chưa có đơn hàng nào</h5>
                                <p class="text-secondary">Hãy khám phá bộ sưu tập cà phê của chúng tôi và đặt hàng nhé!</p>
                                <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom mt-2 rounded-pill px-4">Mua Sắm Ngay</a>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Address Modal -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-action="AddAddress" method="post">
          <div class="modal-header">
            <h5 class="modal-title text-coffee">Thêm địa chỉ mới</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
                <label class="form-label">Họ và tên</label>
                <input type="text" class="form-control" name="FullName" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Số điện thoại</label>
                <input type="tel" class="form-control" name="PhoneNumber" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Địa chỉ cụ thể</label>
                <textarea class="form-control" name="AddressLine" rows="3" required></textarea>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="IsDefault" value="true" id="checkDefaultNew">
                <label class="form-check-label" for="checkDefaultNew">Đặt làm địa chỉ mặc định</label>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-primary-custom">Thêm địa chỉ</button>
          </div>
      </form>
    </div>
  </div>
</div>

<style>
/* Custom style for vertical tabs so they have the brown/gold look */
.custom-tabs .nav-link {
    color: var(--text-secondary);
    transition: all var(--transition-fast);
}
.custom-tabs .nav-link:hover {
    background-color: var(--cream);
    color: var(--coffee-brown);
}
.custom-tabs .nav-link.active {
    background-color: var(--coffee-brown);
    color: white;
}
.w-20px { width: 20px; }
</style>
