@{
    ViewData["Title"] = "Đặt lại mật khẩu thành công";
}

<div class="container mt-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 shadow-sm">
                <div class="display-1 text-success mb-4">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Thành công!</h2>
                <p class="text-muted fs-5 mb-4">
                    Mật khẩu của bạn đã được thay đổi thành công. Bây giờ bạn có thể đăng nhập bằng mật khẩu mới của mình.
                </p>
                <div class="d-grid gap-2 col-md-8 mx-auto">
                    <a asp-action="Login" class="btn btn-success rounded-pill py-3 fw-bold">ĐĂNG NHẬP NGAY</a>
                </div>
            </div>
        </div>
    </div>
</div>
