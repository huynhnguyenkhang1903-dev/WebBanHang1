@model Websitebanhang.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    var status = Model.Status ?? "Pending";
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item">
                    <a href="/" class="text-secondary">
                        <i class="fa-solid fa-house"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Account" asp-action="Profile" class="text-secondary">
                        Hồ Sơ Của Tôi
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    Đơn Hàng #ORD-@(Model.Id == 0 ? "" : Model.Id.ToString("D3"))
                </li>
            </ol>
        </nav>
    </div>

    <div class="col-12 col-lg-8 mx-auto">
        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">

            <!-- HEADER -->
            <div class="d-flex justify-content-between border-bottom pb-4 mb-4">
                <div>
                    <h3 class="text-coffee fw-bold">Chi Tiết Đơn Hàng</h3>
                    <p class="mb-0">
                        Mã đơn:
                        <strong>#ORD-@(Model.Id == 0 ? "" : Model.Id.ToString("D3"))</strong>
                    </p>
                </div>

                <div class="text-end">
                    <p class="small text-muted">
                        @(Model.OrderDate == default ? "" : Model.OrderDate.ToString("dd/MM/yyyy HH:mm"))
                    </p>

                    @* STATUS *@
                    @switch (status)
                    {
                        case "Pending":
                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                            break;
                        case "Confirmed":
                            <span class="badge bg-info">Chờ lấy hàng</span>
                            break;
                        case "Shipping":
                            <span class="badge bg-primary">Đang giao</span>
                            break;
                        case "Delivered":
                            <span class="badge bg-success">Đã giao</span>
                            break;
                        case "Cancelled":
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@status</span>
                            break;
                    }
                </div>
            </div>

            <!-- TIẾN TRÌNH -->
            @{
                bool IsActive(string step)
                {
                    var steps = new[] { "Pending", "Confirmed", "Shipping", "Delivered" };
                    var current = Array.IndexOf(steps, status);
                    var target = Array.IndexOf(steps, step);

                    if (status == "Cancelled") return false;

                    return target <= current;
                }
            }

            <div class="d-flex justify-content-between text-center mb-4">
                <div class="flex-fill @(IsActive("Pending") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-clock"></i>
                    <div>Chờ xác nhận</div>
                </div>
                <div class="flex-fill @(IsActive("Confirmed") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-box"></i>
                    <div>Chờ lấy hàng</div>
                </div>
                <div class="flex-fill @(IsActive("Shipping") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-truck"></i>
                    <div>Đang giao</div>
                </div>
                <div class="flex-fill @(IsActive("Delivered") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-check"></i>
                    <div>Đã giao</div>
                </div>
            </div>

            @if (status == "Cancelled")
            {
                <div class="alert alert-danger text-center">
                    Đơn hàng đã bị hủy
                    @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
                    {
                        <div class="mt-2 small text-danger">Lý do: @Model.CancelReason</div>
                    }
                </div>
            }

            <!-- CUSTOMER -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <strong>Người nhận:</strong> @Model.CustomerName <br />
                        <strong>SĐT:</strong> @Model.Phone <br />
                        <strong>Địa chỉ:</strong> @Model.Address
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded">
                        <strong>Thanh toán:</strong> @Model.PaymentMethod <br />
                        <strong>Trạng thái:</strong>
                        @(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
                    </div>
                </div>
            </div>

            <!-- PRODUCTS -->
            <table class="table">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" width="60" height="60"
                                         onerror="this.src='/images/default.jpg'" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.Price.ToString("N0") ₫</td>
                                <td>@(item.Price * item.Quantity) ₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <h5 class="text-end text-danger">
                Tổng: @Model.TotalAmount.ToString("N0") ₫
            </h5>

            <!-- 🔥 ADMIN ACTION -->
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-4 text-center">

                    @if (status == "Pending")
                    {
                        <form asp-controller="AdminOrder" asp-action="Confirm" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-success">Duyệt đơn</button>
                        </form>
                    }

                    @if (status == "Confirmed")
                    {
                        <form asp-controller="AdminOrder" asp-action="Shipping" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-primary">Giao hàng</button>
                        </form>
                    }

                    @if (status == "Shipping")
                    {
                        <form asp-controller="AdminOrder" asp-action="Delivered" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-dark">Hoàn thành</button>
                        </form>
                    }

                    @if (status == "Delivered")
                    {
                        <form asp-controller="AdminOrder" asp-action="ProcessReturn" method="post" class="d-inline-block">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-warning">Xử lý trả/hoàn tiền</button>
                        </form>
                    }
                    @if (status != "Delivered" && status != "Cancelled")
                    {
                        <form asp-controller="AdminOrder" asp-action="Cancel" method="post" class="mt-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />

                            <div class="mb-2">
                                <textarea name="cancelReason" class="form-control" placeholder="Nhập lý do hủy..." required></textarea>
                            </div>

                            <button class="btn btn-danger">Hủy đơn</button>
                        </form>
                    }

                    @if (status != "Delivered" && status != "Cancelled")
                    {
                        <form asp-controller="AdminOrder" asp-action="Cancel" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button class="btn btn-danger">Hủy đơn</button>
                        </form>
                    }
                </div>
            }
            else
            {
                // User actions
                if (!Model.IsPaid && status == "Pending")
                {
                    <form asp-controller="Account" asp-action="CancelOrder" method="post" class="d-inline-block" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Hủy</button>
                    </form>
                }

                if (status == "Delivered")
                {
                    <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#returnModal">Yêu cầu trả hàng</button>
                }
            }

            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-info me-2 text-white">
                    <i class="fa-solid fa-print"></i> In hóa đơn
                </a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-dark">
                    Quay lại
                </a>
            </div>

        </div>
    </div>
</div>

<!-- Modal for return request -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-controller="Account" asp-action="RequestReturn" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="modal-header">
          <h5 class="modal-title" id="returnModalLabel">Yêu cầu trả hàng</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="returnReason" class="form-label">Lý do trả hàng</label>
            <textarea class="form-control" id="returnReason" name="returnReason" rows="3" required></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-warning">Gửi yêu cầu</button>
        </div>
      </form>
    </div>
  </div>
</div>