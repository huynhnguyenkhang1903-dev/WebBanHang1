@model Websitebanhang.Models.Order
@inject Websitebanhang.Services.IWebsiteSettingService SettingService
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng";
    var status = Model.Status ?? "Pending";
    var returnLimitStr = await SettingService.GetSettingAsync("ReturnDaysLimit", "7");
    int.TryParse(returnLimitStr, out int returnDaysLimit);
}

<div class="row fade-in">
    <!-- Breadcrumb -->
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 px-3 py-2 bg-white rounded-pill shadow-sm d-inline-flex">
                <li class="breadcrumb-item">
                    <a href="/" class="text-secondary">
                        <i class="fa-solid fa-house"></i>
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Account" asp-action="Profile" class="text-secondary">
                        Hồ Sơ Của Tôi
                    </a>
                </li>
                <li class="breadcrumb-item active">
                    Đơn Hàng #ORD-@(Model.Id == 0 ? "" : Model.Id.ToString("D3"))
                </li>
            </ol>
        </nav>
    </div>

    <div class="col-12 col-lg-8 mx-auto">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="bg-white rounded-4 shadow-sm p-4 p-md-5">

            <!-- HEADER -->
            <div class="d-flex justify-content-between border-bottom pb-4 mb-4">
                <div>
                    <h3 class="text-coffee fw-bold">Chi Tiết Đơn Hàng</h3>
                    <p class="mb-0">
                        Mã đơn:
                        <strong>#ORD-@(Model.Id == 0 ? "" : Model.Id.ToString("D3"))</strong>
                    </p>
                </div>

                <div class="text-end">
                    <p class="small text-muted">
                        @(Model.OrderDate == default(DateTime) ? "" : Model.OrderDate.ToString("dd/MM/yyyy HH:mm"))
                    </p>

                    @* STATUS *@
                    @switch (status)
                    {
                        case "Pending":
                            <span class="badge bg-warning text-dark">Chờ xác nhận</span>
                            break;
                        case "Confirmed":
                            <span class="badge bg-info">Đã duyệt đơn</span>
                            break;
                        case "Preparing":
                            <span class="badge bg-warning text-dark">Đang đóng gói</span>
                            break;
                        case "Shipping":
                        case "Delivered":
                            <span class="badge bg-success">Đã giao</span>
                            break;
                        case "Cancelled":
                            <span class="badge bg-danger">Đã hủy</span>
                            break;
                        default:
                            <span class="badge bg-secondary">@status</span>
                            break;
                    }
                </div>
            </div>

            <!-- TIẾN TRÌNH -->
            @{
                bool IsActive(string step)
                {
                    var steps = new[] { "Pending", "Confirmed", "Preparing", "Shipping", "Delivered" };
                    var current = Array.IndexOf(steps, status);
                    var target = Array.IndexOf(steps, step);

                    if (status == "Cancelled") return false;

                    return target <= current;
                }
            }

            <div class="d-flex justify-content-between text-center mb-4">
                <div class="flex-fill @(IsActive("Pending") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-clock"></i>
                    <div>Chờ xác nhận</div>
                </div>
                <div class="flex-fill @(IsActive("Confirmed") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-check-double"></i>
                    <div>Đã duyệt</div>
                </div>
                <div class="flex-fill @(IsActive("Preparing") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-box"></i>
                    <div>Đóng gói</div>
                </div>
                <div class="flex-fill @(IsActive("Shipping") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-truck"></i>
                    <div>Đang giao</div>
                </div>
                <div class="flex-fill @(IsActive("Delivered") ? "text-success fw-bold" : "text-muted")">
                    <i class="fa-solid fa-house-circle-check"></i>
                    <div>Hoàn thành</div>
                </div>
            </div>

            @if (status == "Cancelled")
            {
                <div class="alert alert-danger text-center rounded-4 shadow-sm">
                    <i class="fa-solid fa-ban me-2"></i> Đơn hàng đã bị hủy
                    @if (!string.IsNullOrWhiteSpace(Model.CancelReason))
                    {
                        <div class="mt-2 small">Lý do: @Model.CancelReason</div>
                    }
                </div>
            }

            @if (status == OrderStatus.ReturnRequested || status == OrderStatus.Returned || status == OrderStatus.Refunded)
            {
                <div class="alert alert-warning text-center rounded-4 shadow-sm border-0 bg-opacity-10" style="background-color: #fff3cd; color: #856404;">
                    <h5 class="fw-bold mb-2">
                        <i class="fa-solid fa-rotate-left me-2"></i> 
                        @(status == OrderStatus.ReturnRequested ? "Đang xử lý yêu cầu trả hàng" : "Yêu cầu trả hàng hoàn tất")
                    </h5>
                    <p class="mb-2"><strong>Lý do của bạn:</strong> @Model.ReturnReason</p>
                    @if (!string.IsNullOrEmpty(Model.ReturnAdminNote))
                    {
                        <div class="p-3 bg-white rounded-3 mt-2 text-start border-start border-warning border-4 shadow-sm">
                            <strong class="text-dark"><i class="fa-solid fa-comment-dots me-2"></i> Phản hồi từ cửa hàng:</strong>
                            <p class="mb-0 mt-1">@Model.ReturnAdminNote</p>
                        </div>
                    }
                </div>
            }

            <!-- CUSTOMER -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded h-100">
                        <strong>Người nhận:</strong> @Model.CustomerName <br />
                        <strong>SĐT:</strong> @Model.Phone <br />
                        <strong>Địa chỉ:</strong> @Model.Address
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light rounded h-100">
                        <strong>ĐV Vận chuyển:</strong> @(string.IsNullOrEmpty(Model.ShippingProvider) ? "Mặc định" : Model.ShippingProvider) <br />
                        <strong>Thanh toán:</strong> @Model.PaymentMethod <br />
                        <strong>Trạng thái:</strong>
                        @(Model.IsPaid ? "Đã thanh toán" : "Chưa thanh toán")
                    </div>
                </div>
            </div>

            <!-- PRODUCTS -->
            <table class="table">
                <thead>
                    <tr>
                        <th>Ảnh</th>
                        <th>Tên</th>
                        <th>SL</th>
                        <th>Giá</th>
                        <th>Tổng</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@item.ImageUrl" width="60" height="60"
                                         onerror="this.src='/images/default.jpg'" />
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Quantity</td>
                                <td>@item.Price.ToString("N0") ₫</td>
                                <td>@(item.Price * item.Quantity) ₫</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <div class="d-flex justify-content-end mb-4">
                <div class="text-end" style="width: 300px;">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tạm tính:</span>
                        <span>@((Model.TotalAmount - Model.ShippingCost).ToString("N0")) ₫</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Phí vận chuyển:</span>
                        <span>@Model.ShippingCost.ToString("N0") ₫</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2">
                        <span class="fw-bold fs-5">Tổng cộng:</span>
                        <span class="fw-bold fs-5 text-danger">@Model.TotalAmount.ToString("N0") ₫</span>
                    </div>
                </div>
            </div>

            <!-- 🔥 ADMIN ACTION QUICK ACCESS -->
            @if (User.IsInRole("Admin"))
            {
                <div class="mt-4 p-3 bg-light rounded-4 border border-warning shadow-sm">
                    <h5 class="text-dark fw-bold mb-3"><i class="fa-solid fa-user-shield me-2"></i> Thao tác Quản trị</h5>
                    <div class="d-flex flex-wrap gap-2 justify-content-center">

                        @if (status == "Pending")
                        {
                            <form asp-controller="AdminOrder" asp-action="Confirm" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button class="btn btn-success rounded-pill px-4">Duyệt đơn</button>
                            </form>
                        }

                        @if (status == "Confirmed")
                        {
                            <form asp-controller="AdminOrder" asp-action="Preparing" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button class="btn btn-warning rounded-pill px-4">Đóng gói</button>
                            </form>
                        }

                        @if (status == "Preparing")
                        {
                            <form asp-controller="AdminOrder" asp-action="Shipping" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button class="btn btn-primary rounded-pill px-4">Giao hàng</button>
                            </form>
                        }

                        @if (status == "Shipping")
                        {
                            <form asp-controller="AdminOrder" asp-action="Delivered" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button class="btn btn-dark rounded-pill px-4">Xác nhận hoàn thành</button>
                            </form>
                        }

                        @if (status == OrderStatus.ReturnRequested)
                        {
                            <a asp-controller="AdminOrder" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-danger rounded-pill px-4">
                                <i class="fa-solid fa-rotate-left me-1"></i> Xem & Xử lý Trả hàng
                            </a>
                        }
                    </div>
                </div>
            }
            else
            {
                // User actions
                if (!Model.IsPaid && status == "Pending")
                {
                    <form asp-controller="Account" asp-action="CancelOrder" method="post" class="d-inline-block" onsubmit="return confirm('Bạn có chắc muốn hủy đơn hàng này?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">Hủy</button>
                    </form>
                }

                if (status == "Shipping")
                {
                    <form asp-controller="Account" asp-action="ConfirmReceived" method="post" class="d-inline-block">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận bạn đã nhận được hàng?')">Đã nhận hàng</button>
                    </form>
                }

                @if (status == OrderStatus.Delivered)
                {
                    var daysSinceOrder = (DateTime.Now - Model.OrderDate).TotalDays;
                    if (daysSinceOrder <= returnDaysLimit)
                    {
                        <button class="btn btn-warning rounded-pill px-4 shadow-sm fw-bold" data-bs-toggle="modal" data-bs-target="#returnModal">
                            <i class="fa-solid fa-rotate-left me-1"></i> Yêu cầu trả hàng / Hoàn tiền
                        </button>
                        <p class="small text-muted mt-2">Chính sách: Bạn có thể yêu cầu trả hàng trong vòng @returnDaysLimit ngày kể từ khi đặt hàng.</p>
                    }
                    else
                    {
                        <div class="alert alert-light border-0 small text-muted py-2">
                            <i class="fa-solid fa-circle-info me-1"></i> Đã quá thời hạn @returnDaysLimit ngày để yêu cầu trả hàng.
                        </div>
                    }
                }
            }

            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="PrintInvoice" asp-route-id="@Model.Id" target="_blank" class="btn btn-info me-2 text-white">
                    <i class="fa-solid fa-print"></i> In hóa đơn
                </a>
                <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-dark">
                    Quay lại
                </a>
            </div>

        </div>
    </div>
</div>

<!-- Modal for return request -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form asp-controller="Account" asp-action="RequestReturn" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="modal-header">
          <h5 class="modal-title" id="returnModalLabel">Yêu cầu trả hàng</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="reasonType" class="form-label fw-bold">Lý do trả hàng</label>
            <select class="form-select" id="reasonType" name="reasonType" required onchange="toggleOtherReason(this)">
                <option value="" disabled selected>Chọn lý do...</option>
                <option value="Sản phẩm bị lỗi/hư hỏng">Sản phẩm bị lỗi/hư hỏng</option>
                <option value="Giao sai sản phẩm">Giao sai sản phẩm</option>
                <option value="Sản phẩm khác mô tả">Sản phẩm khác mô tả</option>
                <option value="Không còn nhu cầu (Sản phẩm chưa bóc tem)">Không còn nhu cầu (Sản phẩm chưa bóc tem)</option>
                <option value="Lý do khác">Lý do khác</option>
            </select>
          </div>
          <div class="mb-3" id="otherReasonDiv" style="display: none;">
            <label for="returnReason" class="form-label fw-bold">Chi tiết lý do</label>
            <textarea class="form-control" id="returnReason" name="returnReason" rows="3" placeholder="Vui lòng mô tả chi tiết tình trạng sản phẩm..."></textarea>
          </div>
        </div>
        <div class="modal-footer border-0">
          <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm">Gửi yêu cầu</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Tự động mở modal nếu được yêu cầu từ trang danh sách
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('requestReturn') === 'true') {
            var modalEl = document.getElementById('returnModal');
            if (modalEl) {
                var myModal = new bootstrap.Modal(modalEl);
                myModal.show();
            }
        }
    });

    function toggleOtherReason(select) {
        var otherDiv = document.getElementById('otherReasonDiv');
        var reasonArea = document.getElementById('returnReason');
        if (select.value === 'Lý do khác') {
            otherDiv.style.display = 'block';
            reasonArea.setAttribute('required', 'required');
            reasonArea.focus();
        } else {
            otherDiv.style.display = 'none';
            reasonArea.removeAttribute('required');
        }
    }
</script>