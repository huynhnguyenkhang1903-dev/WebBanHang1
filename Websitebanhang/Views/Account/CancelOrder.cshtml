@model Websitebanhang.Models.Order

<h3>Hủy đơn hàng</h3>

<form asp-action="CancelOrder" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Lý do hủy đơn</label>
        <textarea name="cancelReason" class="form-control" rows="4" required></textarea>
    </div>

    <button type="submit" class="btn btn-danger">Xác nhận hủy</button>
    <a asp-action="Profile" class="btn btn-secondary">Quay lại</a>
</form>