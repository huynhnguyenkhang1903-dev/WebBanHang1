@model Websitebanhang.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h2 class="text-center mb-4"><i class="fa fa-envelope text-primary me-2"></i>Quên Mật Khẩu</h2>
            <div class="card shadow-sm p-4 border-0">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <p class="text-muted text-center mb-4">Vui lòng nhập email đăng ký tài khoản của bạn. Chúng tôi sẽ gửi một liên kết để khôi phục mật khẩu.</p>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control form-control-lg" placeholder="Nhập địa chỉ email..." />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold"><i class="fa fa-paper-plane me-2"></i>Gửi Link Khôi Phục</button>
                        <a asp-action="Login" class="btn btn-outline-secondary mt-2">Quay lại Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
