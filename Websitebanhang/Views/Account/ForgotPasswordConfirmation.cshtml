@{
    ViewData["Title"] = "Xác nhận gửi yêu cầu";
}

<div class="container mt-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <div class="p-5 bg-white rounded-4 shadow-sm">
                <div class="display-1 text-success mb-4">
                    <i class="fa-solid fa-paper-plane"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Kiểm tra Email của bạn</h2>
                <p class="text-muted fs-5 mb-4">
                    Chúng tôi đã gửi một liên kết đặt lại mật khẩu đến địa chỉ email bạn đã cung cấp. Vui lòng kiểm tra hộp thư đến (và cả thư rác) để tiếp tục.
                </p>
                <div class="d-grid gap-2 col-md-8 mx-auto">
                    <a asp-action="Login" class="btn btn-outline-dark rounded-pill py-2">Quay lại Đăng nhập</a>
                    <a href="/" class="btn btn-link text-secondary text-decoration-none">Về Trang chủ</a>
                </div>
            </div>
        </div>
    </div>
</div>
