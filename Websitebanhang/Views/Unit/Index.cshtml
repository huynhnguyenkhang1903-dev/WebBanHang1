@model IEnumerable<Websitebanhang.Models.UnitOfMeasure>
@{ ViewData["Title"] = "Quản lý Đơn vị Tính"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa fa-balance-scale text-primary me-2"></i>Quản Lý Đơn Vị Tính</h2>
        <a asp-action="Add" class="btn btn-primary"><i class="fa fa-plus me-1"></i>Thêm Mới</a>
    </div>

    <div class="card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>ID</th><th>Tên đơn vị</th><th>Ghi chú</th><th>Hành động</th></tr>
            </thead>
            <tbody>
                @foreach (var item in Model) {
                    <tr>
                        <td class="fw-bold">@item.Id</td>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-action="Update" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fa fa-edit"></i> Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i> Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
