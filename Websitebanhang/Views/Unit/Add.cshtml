@model Websitebanhang.Models.UnitOfMeasure
@{ ViewData["Title"] = "Thêm Đơn Vị Tính"; }

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <h2 class="text-center mb-4"><i class="fa fa-plus-circle text-success me-2"></i>Thêm Đơn Vị Tính</h2>
            <div class="card shadow-sm border-0 border-top border-success border-4 p-4">
                <form asp-action="Add" method="post">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Tên đơn vị (Kg, Lít...)</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả thêm</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                        <button type="submit" class="btn btn-success fw-bold"><i class="fa fa-save me-2"></i>Lưu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
