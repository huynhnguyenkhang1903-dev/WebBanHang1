@{
    ViewData["Title"] = "Trang Quản Trị";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">
                <i class="fa fa-dashboard me-2"></i> Bảng điều khiển Quản trị viên
            </h2>
            <p class="text-muted">Chào mừng bạn trở lại! Dưới đây là tổng quan về hoạt động của cửa hàng.</p>
        </div>
    </div>

    <!-- TỔNG QUAN -->
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body py-4">
                    <i class="fa fa-coffee fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Tổng sản phẩm</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Kho</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body py-4">
                    <i class="fa fa-shopping-cart fa-3x text-success mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Tổng đơn hàng</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Đơn</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="Order" asp-action="Index" class="btn btn-outline-success w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                <div class="card-body py-4">
                    <i class="fa fa-users fa-3x text-warning mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Khách hàng</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý User</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-warning w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>