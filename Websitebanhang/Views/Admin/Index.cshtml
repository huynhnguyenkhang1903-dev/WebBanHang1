@{
    ViewData["Title"] = "Trang Quản Trị";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">
                <i class="fa fa-dashboard me-2"></i> Bảng điều khiển Quản trị viên
            </h2>
            <p class="text-muted">Chào mừng bạn trở lại! Dưới đây là tổng quan về hoạt động của cửa hàng.</p>
        </div>
    </div>

    <!-- ALERTS -->
    @{
        var lowStockProducts = ViewBag.LowStockProducts as List<Websitebanhang.Models.Product>;
        var expiringProducts = ViewBag.ExpiringProducts as List<Websitebanhang.Models.Product>;
    }

    @if (lowStockProducts != null && lowStockProducts.Count > 0)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong><i class="fa fa-exclamation-triangle"></i> Cảnh báo Sắp Hết Hàng:</strong> Có @lowStockProducts.Count sản phẩm tồn kho thấp (&lt;= 10).
            <a href="/Product/Manage" class="alert-link">Kiểm tra ngay</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            <ul class="mb-0 mt-2">
                @foreach(var p in lowStockProducts.Take(5))
                {
                    <li>@p.Name (Còn @p.Stock sản phẩm)</li>
                }
                @if(lowStockProducts.Count > 5)
                {
                    <li><em>... và @(lowStockProducts.Count - 5) sản phẩm khác.</em></li>
                }
            </ul>
        </div>
    }

    @if (expiringProducts != null && expiringProducts.Count > 0)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong><i class="fa-solid fa-clock"></i> Cảnh báo Hết Hạn:</strong> Có @expiringProducts.Count sản phẩm sắp hoặc đã hết hạn sử dụng.
            <a href="/Product/Manage" class="alert-link">Kiểm tra ngay</a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            <ul class="mb-0 mt-2">
                @foreach(var p in expiringProducts.Take(5))
                {
                    <li>@p.Name (Hạn: @p.ExpiryDate?.ToString("dd/MM/yyyy"))</li>
                }
                @if(expiringProducts.Count > 5)
                {
                    <li><em>... và @(expiringProducts.Count - 5) sản phẩm khác.</em></li>
                }
            </ul>
        </div>
    }

    <!-- TỔNG QUAN -->
    <div class="row text-center mb-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body py-4">
                    <i class="fa fa-coffee fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Tổng sản phẩm</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Kho</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="Product" asp-action="Manage" class="btn btn-outline-primary w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body py-4">
                    <i class="fa fa-shopping-cart fa-3x text-success mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Tổng đơn hàng</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Đơn</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="Order" asp-action="Index" class="btn btn-outline-success w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-warning h-100">
                <div class="card-body py-4">
                    <i class="fa fa-users fa-3x text-warning mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Khách hàng</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý User</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="User" asp-action="Index" class="btn btn-outline-warning w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-secondary h-100">
                <div class="card-body py-4">
                    <i class="fa fa-balance-scale fa-3x text-secondary mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Đơn vị đo</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Đơn vị</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="Unit" asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body py-4">
                    <i class="fa-solid fa-comments fa-3x text-info mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Bình luận</h5>
                    <h3 class="fw-bold text-dark mb-0">Quản lý Bình luận</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="AdminReview" asp-action="Index" class="btn btn-outline-info w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-dark h-100">
                <div class="card-body py-4">
                    <i class="fa-solid fa-clock-rotate-left fa-3x text-dark mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Kho hàng</h5>
                    <h3 class="fw-bold text-dark mb-0">Lịch sử kho</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="AdminInventory" asp-action="History" class="btn btn-outline-dark w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem chi tiết
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body py-4">
                    <i class="fa-solid fa-headset fa-3x text-info mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">CSKH</h5>
                    <h3 class="fw-bold text-dark mb-0">Hỗ trợ khách</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="AdminSupport" asp-action="Index" class="btn btn-outline-info w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem yêu cầu
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                <div class="card-body py-4">
                    <i class="fa-solid fa-truck-field fa-3x text-primary mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Cung ứng</h5>
                    <h3 class="fw-bold text-dark mb-0">Nhà cung cấp</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="AdminSupplier" asp-action="Index" class="btn btn-outline-primary w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Quản lý NCC
                    </a>
                </div>
            </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm border-0 border-start border-4 border-secondary h-100">
                <div class="card-body py-4">
                    <i class="fa-solid fa-clock-rotate-left fa-3x text-secondary mb-3"></i>
                    <h5 class="fw-bold text-muted text-uppercase mb-1">Hệ thống</h5>
                    <h3 class="fw-bold text-dark mb-0">Lịch sử hoạt động</h3>
                </div>
                <div class="card-footer bg-white border-0 py-3">
                    <a asp-controller="AdminLog" asp-action="Index" class="btn btn-outline-secondary w-100">
                        <i class="fa fa-arrow-circle-right me-2"></i> Xem nhật ký
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>