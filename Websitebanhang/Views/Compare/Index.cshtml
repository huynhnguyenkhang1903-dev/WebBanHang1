@model List<Websitebanhang.Models.Product>
@{
    ViewData["Title"] = "So sánh sản phẩm";
}

<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">So sánh sản phẩm</h2>
        @if (Model != null && Model.Count > 0)
        {
            <a asp-controller="Compare" asp-action="Clear" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc chắn muốn xóa toàn bộ danh sách so sánh?')">
                <i class="fa fa-trash me-1"></i> Xóa tất cả
            </a>
        }
    </div>

    @if (Model == null || Model.Count == 0)
    {
        <div class="text-center py-5 shadow-sm rounded bg-white">
            <i class="fa-solid fa-code-compare fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">Chưa có sản phẩm nào để so sánh.</h4>
            <a href="/" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded bg-white">
            <table class="table table-bordered text-center align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="w-25 text-start align-middle">Thông số</th>
                        @foreach (var product in Model)
                        {
                            <th class="w-25 position-relative">
                                <a asp-controller="Compare" asp-action="Remove" asp-route-id="@product.Id" class="btn-close position-absolute top-0 end-0 m-2" aria-label="Close" title="Xóa"></a>
                                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid rounded mb-2" style="max-height: 150px; object-fit: contain;" />
                                <h5 class="fw-bold fs-6 mb-0">@product.Name</h5>
                            </th>
                        }
                        @for (int i = Model.Count; i < 3; i++)
                        {
                            <th class="w-25 text-muted align-middle bg-light">
                                <div class="py-4">
                                    <i class="fa fa-plus-circle fa-2x mb-2 text-secondary opacity-50"></i>
                                    <p class="mb-0 fs-6">Thêm sản phẩm</p>
                                </div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Giá</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-danger fw-bold fs-5">@product.Price.ToString("N0") ₫</td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Danh mục</td>
                        @foreach (var product in Model)
                        {
                            <td>@(product.Category?.Name ?? "Không có")</td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Xuất xứ</td>
                        @foreach (var product in Model)
                        {
                            <td>@product.Country</td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Tồn kho</td>
                        @foreach (var product in Model)
                        {
                            <td>
                                @if(product.Stock > 0) { <span class="badge bg-success">Còn hàng (@product.Stock)</span> }
                                else { <span class="badge bg-danger">Hết hàng</span> }
                            </td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Hạn sử dụng</td>
                        @foreach (var product in Model)
                        {
                            <td>@(product.ExpiryDate.HasValue ? product.ExpiryDate.Value.ToString("dd/MM/yyyy") : "Không có")</td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Mô tả</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-start small">@product.Description</td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                    <tr>
                        <td class="fw-bold text-start text-muted bg-light">Hành động</td>
                        @foreach (var product in Model)
                        {
                            <td>
                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-id="@product.Id" class="btn btn-primary btn-sm w-100">
                                    <i class="fa fa-shopping-cart"></i> Thêm vào giỏ
                                </a>
                            </td>
                        }
                        @for (int i = Model.Count; i < 3; i++) { <td class="bg-light"></td> }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
