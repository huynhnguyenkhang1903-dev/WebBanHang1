@model IEnumerable<Websitebanhang.Models.Promotion>

@{
    ViewData["Title"] = "Chương trình Khuyến mãi";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-success">
            <i class="fa-solid fa-bullhorn me-2"></i> Chương trình Khuyến mãi
        </h2>
        <a asp-action="Create" class="btn btn-success fw-bold shadow-sm rounded-pill px-4">
            <i class="fa-solid fa-plus me-2"></i> Tạo Khuyến mãi Mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 border-0 shadow-sm" role="alert">
            <i class="fa-solid fa-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Tên chương trình</th>
                            <th>Mã KM</th>
                            <th class="text-center">Giảm (%)</th>
                            <th>Thời gian áp dụng</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">Chưa có chương trình khuyến mãi nào.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            var now = DateTime.Now;
                            var isRunning = item.IsActive && now >= item.StartDate && now <= item.EndDate;
                            var isFinished = now > item.EndDate;
                            var isUpcoming = now < item.StartDate;

                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-primary border border-primary">@item.Code</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-danger rounded-pill px-3">@item.DiscountPercent%</span>
                                </td>
                                <td>
                                    <div class="small">
                                        <div><i class="fa-solid fa-calendar-play me-2 text-primary"></i>Từ: @item.StartDate.ToString("dd/MM/yyyy")</div>
                                        <div><i class="fa-solid fa-calendar-check me-2 text-danger"></i>Đến: @item.EndDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    @if (!item.IsActive)
                                    {
                                        <span class="badge bg-secondary">Đã tắt</span>
                                    }
                                    else if (isRunning)
                                    {
                                        <span class="badge bg-success">Đang diễn ra</span>
                                    }
                                    else if (isFinished)
                                    {
                                        <span class="badge bg-dark">Đã kết thúc</span>
                                    }
                                    else if (isUpcoming)
                                    {
                                        <span class="badge bg-info text-dark">Sắp diễn ra</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fa-solid fa-edit"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xóa chương trình khuyến mãi này?');" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>