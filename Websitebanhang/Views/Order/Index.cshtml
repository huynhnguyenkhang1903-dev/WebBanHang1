@model IEnumerable<Websitebanhang.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa fa-shopping-cart text-success me-2"></i> Quản Lý Đơn Hàng</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã ĐH</th>
                            <th>Khách hàng</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Ngày đặt</th>
                            <th>Phương thức</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>@item.CustomerName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="badge bg-secondary">@item.PaymentMethod</span></td>
                                <td class="text-danger fw-bold">@item.TotalAmount.ToString("N0") ₫</td>
                                <td>
                                    <span class="badge @(item.Status == "Pending" ? "bg-warning text-dark" : item.Status == "Cancelled" ? "bg-danger" : "bg-success")">
                                        @item.Status
                                    </span>
                                </td>
                                <td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="d-flex gap-1">
                                            @* Confirm *@
                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-controller="Order" asp-action="Confirm" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success">Duyệt</button>
                                                </form>
                                            }

                                            @* Shipping *@
                                            @if (item.Status == "Confirmed")
                                            {
                                                <form asp-controller="Order" asp-action="Shipping" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-primary">Giao</button>
                                                </form>
                                            }

                                            @* Delivered *@
                                            @if (item.Status == "Shipping")
                                            {
                                                <form asp-controller="Order" asp-action="Delivered" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-dark">Hoàn thành</button>
                                                </form>
                                            }

                                            @* Cancel (allow admin to cancel unless already delivered) *@
                                            @if (item.Status != "Delivered" && item.Status != "Cancelled")
                                            {
                                                <form asp-controller="Order" asp-action="Cancel" method="post" class="m-0 p-0" onsubmit="return confirm('Bạn có chắc muốn hủy đơn này?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger">Hủy</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>