@model IEnumerable<Websitebanhang.Models.Order>

@{
    ViewData["Title"] = "Quáº£n lÃ½ ÄÆ¡n hÃ ng";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="fa fa-shopping-cart text-success me-2"></i> Quáº£n LÃ½ ÄÆ¡n HÃ ng</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>MÃ£ ÄH</th>
                            <th>KhÃ¡ch hÃ ng</th>
                            <th>Email</th>
                            <th>Sá»‘ Ä‘iá»‡n thoáº¡i</th>
                            <th>NgÃ y Ä‘áº·t</th>
                            <th>Thanh toÃ¡n</th>
                            <th>Tá»•ng tiá»n</th>
                            <th>Tráº¡ng thÃ¡i</th>
                            <th>HÃ nh Ä‘á»™ng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td>@item.CustomerName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @if (item.PaymentMethod == "bank")
                                    {
                                        if (!item.IsPaid)
                                        {
                                            <span class="badge bg-danger">Unconfirmed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                    }
                                    else if (item.PaymentMethod == "cod")
                                    {
                                        <span class="badge bg-secondary">COD</span>
                                    }
                                    else if (item.PaymentMethod == "vnpay")
                                    {
                                        if (item.IsPaid)
                                        {
                                            <span class="badge bg-success">VNPay âœ“</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">VNPay</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.PaymentMethod</span>
                                    }
                                </td>
                                <td class="text-danger fw-bold">@item.TotalAmount.ToString("N0") â‚«</td>
                                <td>
                                    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                    {
                                        <form method="post" action="/Order/CapNhatTrangThai" class="m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <select name="trangThai" onchange="this.form.submit()"
                                                    style="border-radius:8px; padding:4px 8px; font-size:13px;
                                                           background-color: @(item.Status == "Waiting for confirmation" ? "#FEF3C7" :
                                                                              item.Status == "Approved" ? "#DBEAFE" :
                                                                              item.Status == "Packed" ? "#FED7AA" :
                                                                              item.Status == "Delivering" ? "#E9D5FF" :
                                                                              item.Status == "Completed" ? "#D1FAE5" :
                                                                              item.Status == "Cancelled" ? "#FEE2E2" : "#f8f9fa");">
                                                <option value="Waiting for confirmation" selected="@(item.Status == "Waiting for confirmation" ? "selected" : null)">â³ Waiting for confirmation</option>
                                                <option value="Approved" selected="@(item.Status == "Approved" ? "selected" : null)">âœ… Approved</option>
                                                <option value="Packed" selected="@(item.Status == "Packed" ? "selected" : null)">ðŸ“¦ Packed</option>
                                                <option value="Delivering" selected="@(item.Status == "Delivering" ? "selected" : null)">ðŸšš Delivering</option>
                                                <option value="Completed" selected="@(item.Status == "Completed" ? "selected" : null)">ðŸŽ‰ Completed</option>
                                                <option value="Cancelled" selected="@(item.Status == "Cancelled" ? "selected" : null)">âŒ Cancelled</option>
                                            </select>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (User.IsInRole("Admin") || User.IsInRole("NhanVien"))
                                    {
                                        <div class="d-flex gap-1">
                                            @* Confirm *@
                                            @if (item.Status == "Pending")
                                            {
                                                <form asp-controller="AdminOrder" asp-action="Confirm" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-success">Duyá»‡t</button>
                                                </form>
                                            }

                                            @* Shipping *@
                                            @if (item.Status == "Confirmed")
                                            {
                                                <form asp-controller="AdminOrder" asp-action="Shipping" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-primary">Giao</button>
                                                </form>
                                            }

                                            @* Delivered *@
                                            @if (item.Status == "Shipping")
                                            {
                                                <form asp-controller="AdminOrder" asp-action="Delivered" method="post" class="m-0 p-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-dark">HoÃ n thÃ nh</button>
                                                </form>
                                            }

                                            @* Process Return (link to details) *@
                                            @if (item.Status == OrderStatus.ReturnRequested || item.Status == OrderStatus.Delivered)
                                            {
                                                <a asp-controller="AdminOrder" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                                    <i class="fa-solid fa-rotate-left"></i> Xá»­ lÃ½ Tráº£/HoÃ n tiá»n
                                                </a>
                                            }

                                            @* Cancel (allow admin to cancel unless already delivered/refunded) *@
                                            @if (item.Status != "Delivered" && item.Status != "Cancelled" && item.Status != "Refunded")
                                            {
                                                <form asp-controller="AdminOrder" asp-action="Cancel" method="post" class="m-0 p-0" onsubmit="return confirm('Báº¡n cÃ³ cháº¯c muá»‘n há»§y Ä‘Æ¡n nÃ y?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-danger">Há»§y</button>
                                                </form>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="OrderDetails" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Xem</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (TempData["Success"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (typeof Toastify !== 'undefined') {
                    Toastify({
                        text: "@Html.Raw(TempData["Success"]?.ToString())",
                        duration: 3000,
                        gravity: "top", // `top` or `bottom`
                        position: "right", // `left`, `center` or `right`
                        stopOnFocus: true, // Prevents dismissing of toast on hover
                        style: {
                            background: "linear-gradient(to right, #00b09b, #96c93d)",
                            borderRadius: "8px",
                            fontFamily: "'Inter', sans-serif"
                        }
                    }).showToast();
                }
            });
        </script>
    }
}
