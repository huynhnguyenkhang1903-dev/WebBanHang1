@model Websitebanhang.Models.Banner

@{
    ViewData["Title"] = "Chỉnh Sửa Banner";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white">
                <h4 class="mb-0">Chỉnh Sửa Banner #@Model.Id</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3 text-center bg-light p-3 rounded">
                        <p class="mb-2 fw-bold">Ảnh hiện tại:</p>
                        <img src="@Model.ImageUrl" alt="Banner" class="img-fluid rounded border shadow-sm" style="max-height: 200px;" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subtitle" class="form-label fw-bold"></label>
                        <input asp-for="Subtitle" class="form-control" />
                        <span asp-validation-for="Subtitle" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tải lên ảnh mới (Bỏ trống nếu giữ nguyên)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="OrderIndex" class="form-label fw-bold"></label>
                            <input asp-for="OrderIndex" type="number" class="form-control" />
                        </div>
                        <div class="col-md-6 d-flex align-items-end pb-2">
                            <div class="form-check form-switch fs-5">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" role="switch" />
                                <label class="form-check-label ms-2 fs-6" asp-for="IsActive">Kích hoạt</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">Lưu cập nhật</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
